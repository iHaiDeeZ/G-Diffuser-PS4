new file mode 100644
index 0000000..76b3645
--- /dev/null
+++ b/port/ps4/ps4_paths.cpp
@@ -0,0 +1,133 @@
+// port/ps4/ps4_paths.cpp -- relative paths on the PS4.
+//
+// G-Diffuser opens much of its state by relative path ("saves/fzerox.sav", "saves/...json", the
+// config and logs), expecting the working directory to be the game folder. On the console
+// chdir() succeeds but relative paths still do not resolve (and getcwd() fails), so the libc
+// entry points that take a path are wrapped (linker --wrap, port/CMakeLists.txt) and resolve
+// relative paths against /data/gdiffuser. Absolute paths pass through untouched.
+#include <cerrno>
+#include <cstdarg>
+#include <cstdio>
+#include <cstring>
+
+#include <dirent.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace {
+
+const char kRoot[] = "/data/gdiffuser/";
+
+// Returns `path` itself when it is absolute (or null/empty), else `buf` holding the joined path.
+const char* Resolve(const char* path, char* buf, size_t size) {
+    if (path == nullptr || path[0] == '\0' || path[0] == '/') {
+        return path;
+    }
+    while (path[0] == '.' && path[1] == '/') {
+        path += 2;
+    }
+    if (path[0] == '.' && path[1] == '\0') {
+        path = "";
+    }
+    snprintf(buf, size, "%s%s", kRoot, path);
+    return buf;
+}
+
+} // namespace
+
+#define GDX_PS4_PATH(var, path)                                                                   \
+    char var##Buf[1024];                                                                          \
+    const char* var = Resolve(path, var##Buf, sizeof(var##Buf))
+
+extern "C" {
+
+int __real_open(const char* path, int flags, ...);
+int __wrap_open(const char* path, int flags, ...) {
+    mode_t mode = 0;
+    if (flags & O_CREAT) {
+        va_list args;
+        va_start(args, flags);
+        mode = (mode_t)va_arg(args, int);
+        va_end(args);
+    }
+    GDX_PS4_PATH(p, path);
+    return __real_open(p, flags, mode);
+}
+
+FILE* __real_fopen(const char* path, const char* mode);
+FILE* __wrap_fopen(const char* path, const char* mode) {
+    GDX_PS4_PATH(p, path);
+    return __real_fopen(p, mode);
+}
+
+int __real_stat(const char* path, struct stat* st);
+int __wrap_stat(const char* path, struct stat* st) {
+    GDX_PS4_PATH(p, path);
+    return __real_stat(p, st);
+}
+
+int __real_lstat(const char* path, struct stat* st);
+int __wrap_lstat(const char* path, struct stat* st) {
+    GDX_PS4_PATH(p, path);
+    return __real_lstat(p, st);
+}
+
+int __real_access(const char* path, int mode);
+int __wrap_access(const char* path, int mode) {
+    GDX_PS4_PATH(p, path);
+    return __real_access(p, mode);
+}
+
+// mkdir on an existing directory must fail with EEXIST, which callers treat as success
+// (gdx_achievements and sram_buffer's saves/); the console reports something else.
+int __real_mkdir(const char* path, mode_t mode);
+int __wrap_mkdir(const char* path, mode_t mode) {
+    GDX_PS4_PATH(p, path);
+    const int r = __real_mkdir(p, mode);
+    if (r != 0 && errno != EEXIST) {
+        const int saved = errno;
+        struct stat st;
+        errno = (p != nullptr && __real_stat(p, &st) == 0 && S_ISDIR(st.st_mode)) ? EEXIST : saved;
+    }
+    return r;
+}
+
+int __real_rmdir(const char* path);
+int __wrap_rmdir(const char* path) {
+    GDX_PS4_PATH(p, path);
+    return __real_rmdir(p);
+}
+
+int __real_unlink(const char* path);
+int __wrap_unlink(const char* path) {
+    GDX_PS4_PATH(p, path);
+    return __real_unlink(p);
+}
+
+int __real_remove(const char* path);
+int __wrap_remove(const char* path) {
+    GDX_PS4_PATH(p, path);
+    return __real_remove(p);
+}
+
+int __real_rename(const char* from, const char* to);
+int __wrap_rename(const char* from, const char* to) {
+    GDX_PS4_PATH(f, from);
+    GDX_PS4_PATH(t, to);
+    return __real_rename(f, t);
+}
+
+DIR* __real_opendir(const char* path);
+DIR* __wrap_opendir(const char* path) {
+    GDX_PS4_PATH(p, path);
+    return __real_opendir(p);
+}
+
+int __real_truncate(const char* path, off_t length);
+int __wrap_truncate(const char* path, off_t length) {
+    GDX_PS4_PATH(p, path);
+    return __real_truncate(p, length);
+}
+
+} // extern "C"
