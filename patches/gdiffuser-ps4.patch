+    int i;
+    for (i = 0; sAssetSegmentMap[i].sym != NULL; i++) {
+        if (sAssetSegmentMap[i].segment == seg && sAssetSegmentMap[i].offset == off) {
+            return 1;
+        }
+    }
+    return 0;
+}
