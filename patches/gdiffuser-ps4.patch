diff --git a/port/gdx_fiber_ps4.c b/port/gdx_fiber_ps4.c
new file mode 100644
index 0000000..e7b9024
--- /dev/null
+++ b/port/gdx_fiber_ps4.c
@@ -0,0 +1,147 @@
+/* port/gdx_fiber_ps4.c -- PS4 fiber backend for gdx_fiber.h.
+ *
+ * The OpenOrbis C library is musl, which has no getcontext/makecontext/swapcontext, so this is
+ * the "~40-line x86-64 asm switch behind this same API" that gdx_fiber_ucontext.c names as its
+ * escape hatch. The PS4 kernel uses the System V AMD64 ABI, so a switch saves the callee-saved
+ * registers (rbx, rbp, r12-r15), the SSE control word (MXCSR) and the x87 control word on the
+ * outgoing stack, stores rsp in the outgoing fiber and loads the incoming one. No signal mask is
+ * involved, unlike swapcontext.
+ *
+ * Stacks come from the heap (aligned_alloc). No guard page: mprotect on heap memory is not
+ * dependable on the PS4, and a guard page is only a diagnostic aid. The default stack is 1 MB,
+ * like the other backends.
+ */
+#include "gdx_fiber.h"
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <pthread.h>
+
+struct GdxFiber {
+    void*         sp;     /* saved stack pointer while not running */
+    void*         stack;  /* heap stack; NULL for the converted host thread */
+    GdxFiberEntry entry;
+    void*         arg;
+};
+
+static __thread GdxFiber* sCurrent = NULL;
+
+/* gdx_ps4_fiber_swap(void** save_sp, void* load_sp): save the running context on its stack and
+ * resume the one whose stack pointer is load_sp. Layout from the top of a saved stack:
+ * return address, rbp, rbx, r12, r13, r14, r15, then 8 bytes holding MXCSR (low 4) and the x87
+ * control word (next 2). */
+void gdx_ps4_fiber_swap(void** save_sp, void* load_sp);
+__asm__(
+    ".text\n"
+    ".globl gdx_ps4_fiber_swap\n"
+    ".type gdx_ps4_fiber_swap,@function\n"
+    "gdx_ps4_fiber_swap:\n"
+    "    pushq %rbp\n"
+    "    pushq %rbx\n"
+    "    pushq %r12\n"
+    "    pushq %r13\n"
+    "    pushq %r14\n"
+    "    pushq %r15\n"
+    "    subq $8, %rsp\n"
+    "    stmxcsr (%rsp)\n"
+    "    fnstcw 4(%rsp)\n"
+    "    movq %rsp, (%rdi)\n"
+    "    movq %rsi, %rsp\n"
+    "    ldmxcsr (%rsp)\n"
+    "    fldcw 4(%rsp)\n"
+    "    addq $8, %rsp\n"
+    "    popq %r15\n"
+    "    popq %r14\n"
+    "    popq %r13\n"
+    "    popq %r12\n"
+    "    popq %rbx\n"
+    "    popq %rbp\n"
+    "    ret\n"
+    ".size gdx_ps4_fiber_swap, .-gdx_ps4_fiber_swap\n");
+
+/* First code a new fiber runs: gdx_ps4_fiber_swap "returns" here with rsp 16-byte aligned, the
+ * state a function sees right before a call. The entry is not expected to return (the decomp
+ * threads end in __osCleanupThread, which reschedules), so returning aborts, as the ucontext
+ * backend does. */
+static void gdx_ps4_fiber_start(void) {
+    GdxFiber* f = sCurrent;
+    f->entry(f->arg);
+    abort();
+}
+
+/* Pushes the trampoline's return address after the stack pointer is aligned, so the trampoline
+ * starts with rsp % 16 == 8, exactly as after a call instruction. */
+void gdx_ps4_fiber_boot(void);
+__asm__(
+    ".text\n"
+    ".globl gdx_ps4_fiber_boot\n"
+    ".type gdx_ps4_fiber_boot,@function\n"
+    "gdx_ps4_fiber_boot:\n"
+    "    andq $-16, %rsp\n"
+    "    callq *%rbx\n"
+    "    ud2\n"
+    ".size gdx_ps4_fiber_boot, .-gdx_ps4_fiber_boot\n");
+
+GdxFiber* gdx_fiber_convert_thread(void) {
+    GdxFiber* f = (GdxFiber*) calloc(1, sizeof(*f));
+    if (f == NULL) {
+        return NULL;
+    }
+    sCurrent = f; /* the calling thread IS this context right now */
+    return f;
+}
+
+GdxFiber* gdx_fiber_create(GdxFiberEntry entry, void* arg, size_t stackSize) {
+    GdxFiber* f;
+    uint64_t* top;
+    uint32_t mxcsr;
+    uint16_t fpucw;
+
+    if (stackSize == 0) {
+        stackSize = 1024u * 1024u; /* 1 MB default, matching the other backends */
+    }
+    stackSize = (stackSize + 63u) & ~(size_t) 63u;
+
+    f = (GdxFiber*) calloc(1, sizeof(*f));
+    if (f == NULL) {
+        return NULL;
+    }
+    f->stack = aligned_alloc(64, stackSize);
+    if (f->stack == NULL) {
+        free(f);
+        return NULL;
+    }
+    f->entry = entry;
+    f->arg = arg;
+
+    /* A frame shaped like one gdx_ps4_fiber_swap saved: it "returns" into gdx_ps4_fiber_boot
+     * with rbx = the C trampoline. The new fiber inherits the creator's FP control state. */
+    __asm__ volatile("stmxcsr %0" : "=m"(mxcsr));
+    __asm__ volatile("fnstcw %0" : "=m"(fpucw));
+    top = (uint64_t*) ((char*) f->stack + stackSize);
+    *--top = 0;                                /* padding: keeps the frame 16-byte aligned */
+    *--top = (uint64_t) (uintptr_t) gdx_ps4_fiber_boot; /* return address */
+    *--top = 0;                                /* rbp */
+    *--top = (uint64_t) (uintptr_t) gdx_ps4_fiber_start; /* rbx */
+    *--top = 0;                                /* r12 */
+    *--top = 0;                                /* r13 */
+    *--top = 0;                                /* r14 */
+    *--top = 0;                                /* r15 */
+    *--top = (uint64_t) mxcsr | ((uint64_t) fpucw << 32);
+    f->sp = top;
+    return f;
+}
+
+void gdx_fiber_switch(GdxFiber* to) {
+    GdxFiber* from = sCurrent;
+    if (to == from) {
+        return;
+    }
+    sCurrent = to;
+    gdx_ps4_fiber_swap(&from->sp, to->sp);
+}
+
+unsigned long gdx_fiber_current_thread_id(void) {
+    return (unsigned long) (uintptr_t) pthread_self();
+}
