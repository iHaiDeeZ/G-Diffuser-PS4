diff --git a/port/gdx_lowimage_win.cpp b/port/gdx_lowimage_win.cpp
new file mode 100644
index 0000000..0002b23
--- /dev/null
+++ b/port/gdx_lowimage_win.cpp
@@ -0,0 +1,50 @@
+// port/gdx_lowimage_win.cpp -- GDX_LOW_IMAGE Windows test build only.
+//
+// Reproduces the PS4's address layout on a PC: the executable is linked at /BASE:0x400000 with
+// ASLR off (port/CMakeLists.txt), so its .data/.bss addresses fit in 32 bits and overlap N64
+// segment addresses 0x01xxxxxx-0x04xxxxxx exactly as the PS4 eboot's do, while every heap
+// allocation stays above 4 GiB like the PS4's dlmalloc heap (0x1040000000). The second half is
+// done here: before ordinary static constructors run, every free range below 4 GiB is reserved, so
+// later VirtualAlloc/HeapAlloc growth can only land above it. The bridge's GDX_IMAGE_BELOW_4G
+// fixes then run on Windows with the D3D11 renderer, which separates address bugs from the PS4
+// Vulkan backend.
+#if defined(_WIN32) && defined(GDX_LOW_IMAGE)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <cstdint>
+#include <cstdio>
+
+#pragma warning(disable : 4073)
+#pragma init_seg(lib)
+
+namespace {
+struct ReserveLowAddressSpace {
+    ReserveLowAddressSpace() {
+        MEMORY_BASIC_INFORMATION mbi;
+        uintptr_t addr = 0x10000;
+        unsigned long long reserved = 0;
+        while (addr < 0x100000000ull && VirtualQuery(reinterpret_cast<void*>(addr), &mbi, sizeof(mbi)) != 0) {
+            const uintptr_t base = reinterpret_cast<uintptr_t>(mbi.BaseAddress);
+            const uintptr_t end = base + mbi.RegionSize;
+            if (mbi.State == MEM_FREE) {
+                const uintptr_t a = (base + 0xFFFF) & ~static_cast<uintptr_t>(0xFFFF); // allocation granularity
+                const uintptr_t e = end < 0x100000000ull ? end : 0x100000000ull;
+                if (e > a && VirtualAlloc(reinterpret_cast<void*>(a), e - a, MEM_RESERVE, PAGE_NOACCESS) != nullptr) {
+                    reserved += e - a;
+                }
+            }
+            if (end <= addr) {
+                break;
+            }
+            addr = end;
+        }
+        char line[128];
+        snprintf(line, sizeof(line), "[lowimage] image at %p, reserved %llu MiB below 4 GiB\n",
+                 static_cast<void*>(GetModuleHandleA(nullptr)), reserved >> 20);
+        OutputDebugStringA(line);
+    }
+} sReserveLowAddressSpace;
+} // namespace
+#endif
