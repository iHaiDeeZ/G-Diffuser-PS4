+// ------------------------------------------------------------------------------------------------
+// Settings and Enhancements: the G-Diffuser menu's own registry (port/gdx_menu_registry.cpp), shown
+// as pad-driven pages -- L1/R1 between pages, Left/Right change the value, Cross toggles or runs.
+// The full-screen menu itself never opens on the console.
+// ------------------------------------------------------------------------------------------------
+
+std::shared_ptr<GdxMenu> gdxMenu() {
+    auto w = window();
+    return w != nullptr ? std::dynamic_pointer_cast<GdxMenu>(w->GetGui()->GetMenu()) : nullptr;
+}
+
+// Pages that only make sense with a mouse and keyboard, or a PC around them.
+bool pcOnlyPage(const std::string& sidebar) {
+    return sidebar == "Mouse" || sidebar == "Controls";
+}
+
+bool usableWidget(const GdxUI::WidgetInfo& w) {
+    switch (w.type) {
+        case GdxUI::WIDGET_CHECKBOX:
+        case GdxUI::WIDGET_CVAR_CHECKBOX:
+        case GdxUI::WIDGET_COMBOBOX:
+        case GdxUI::WIDGET_CVAR_COMBOBOX:
+        case GdxUI::WIDGET_SLIDER_INT:
+        case GdxUI::WIDGET_CVAR_SLIDER_INT:
+        case GdxUI::WIDGET_SLIDER_FLOAT:
+        case GdxUI::WIDGET_CVAR_SLIDER_FLOAT:
+        case GdxUI::WIDGET_CVAR_RADIO_BUTTON:
+        case GdxUI::WIDGET_BUTTON:
+            return true;
+        default:
+            return false;
+    }
+}
+
+const std::vector<GdxMenu::QuickPage>& pages(int section) {
+    static std::vector<GdxMenu::QuickPage> sPages[2];
+    static bool sBuilt = false;
+    if (!sBuilt) {
+        if (auto menu = gdxMenu()) {
+            sBuilt = true;
+            for (int i = 0; i < 2; i++) {
+                for (auto& page : menu->QuickMenuPages({ i == 0 ? "Settings" : "Enhancements" })) {
+                    if (pcOnlyPage(page.sidebar)) {
+                        continue;
+                    }
+                    const bool any = std::any_of(page.widgets.begin(), page.widgets.end(),
+                                                 [](const GdxUI::WidgetInfo* w) { return usableWidget(*w); });
+                    if (any) {
+                        sPages[i].push_back(std::move(page));
+                    }
+                }
+            }
+        }
+    }
+    return sPages[section];
+}
+
+// One row of the current page: a control, or a heading (SEPARATOR_TEXT) over the controls below it.
+struct Item {
+    GdxUI::WidgetInfo* w;
+    bool heading;
+    bool disabled;
+};
+
+// The page as it stands this frame: hidden controls dropped, headings with nothing under them dropped.
+std::vector<Item> pageItems(const GdxMenu::QuickPage& page) {
+    auto menu = gdxMenu();
+    std::vector<Item> items;
+    if (menu == nullptr) {
+        return items;
+    }
+    for (GdxUI::WidgetInfo* w : page.widgets) {
+        if (w->type == GdxUI::WIDGET_SEPARATOR_TEXT) {
+            if (!items.empty() && items.back().heading) {
+                items.pop_back();
+            }
+            items.push_back({ w, true, false });
+            continue;
+        }
+        if (!usableWidget(*w) || menu->QuickMenuHidden(*w)) {
+            continue;
+        }
+        items.push_back({ w, false, menu->QuickMenuDisabled(*w) });
+    }
+    if (!items.empty() && items.back().heading) {
+        items.pop_back();
+    }
+    return items;
+}
+
+template <typename T> T* ptr(const GdxUI::WidgetInfo& w) {
+    T* const* p = std::get_if<T*>(&w.valuePointer);
+    return p != nullptr ? *p : nullptr;
+}
+
+template <typename T> const T& opts(const GdxUI::WidgetInfo& w) {
+    static const T kDefaults{};
+    return w.options != nullptr ? *std::static_pointer_cast<T>(w.options) : kDefaults;
+}
+
+std::string formatted(const char* format, double v, bool integer) {
+    char buf[64];
+    if (format == nullptr || *format == 0) {
+        format = integer ? "%d" : "%.2f";
+    }
+    if (integer) {
+        snprintf(buf, sizeof(buf), format, (int)v);
+    } else {
+        snprintf(buf, sizeof(buf), format, v);
+    }
+    return buf;
+}
+
+int32_t comboValue(const GdxUI::WidgetInfo& w) {
+    if (w.type == GdxUI::WIDGET_COMBOBOX) {
+        int32_t* v = ptr<int32_t>(w);
+        return v != nullptr ? *v : 0;
+    }
+    return CVarGetInteger(w.cVar, (int32_t)opts<UIWidgets::ComboboxOptions>(w).defaultIndex);
+}
+
+// The rows a combobox offers, in order: its comboItems, else its comboMap's keys ascending.
+std::vector<std::pair<int32_t, const char*>> comboRows(const GdxUI::WidgetInfo& w) {
+    std::vector<std::pair<int32_t, const char*>> rows;
+    if (!w.comboItems.empty()) {
+        for (size_t i = 0; i < w.comboItems.size(); i++) {
+            rows.push_back({ (int32_t)i, w.comboItems[i] });
+        }
+    } else {
+        for (const auto& kv : opts<UIWidgets::ComboboxOptions>(w).comboMap) {
+            rows.push_back(kv);
+        }
+        std::sort(rows.begin(), rows.end());
+    }
+    return rows;
+}
+
+std::string widgetValue(const GdxUI::WidgetInfo& w) {
+    switch (w.type) {
+        case GdxUI::WIDGET_CVAR_CHECKBOX:
+            return CVarGetInteger(w.cVar, opts<UIWidgets::CheckboxOptions>(w).defaultValue) ? "On" : "Off";
+        case GdxUI::WIDGET_CHECKBOX: {
+            bool* v = ptr<bool>(w);
+            return v != nullptr && *v ? "On" : "Off";
+        }
+        case GdxUI::WIDGET_COMBOBOX:
+        case GdxUI::WIDGET_CVAR_COMBOBOX: {
+            const int32_t v = comboValue(w);
+            for (const auto& row : comboRows(w)) {
+                if (row.first == v) {
+                    return row.second;
+                }
+            }
+            return std::to_string(v);
+        }
+        case GdxUI::WIDGET_CVAR_SLIDER_INT: {
+            const auto& o = opts<UIWidgets::IntSliderOptions>(w);
+            return formatted(o.format, CVarGetInteger(w.cVar, o.defaultValue), true);
+        }
+        case GdxUI::WIDGET_SLIDER_INT: {
+            int32_t* v = ptr<int32_t>(w);
+            return v != nullptr ? formatted(opts<UIWidgets::IntSliderOptions>(w).format, *v, true) : "";
+        }
+        case GdxUI::WIDGET_CVAR_SLIDER_FLOAT:
+        case GdxUI::WIDGET_SLIDER_FLOAT: {
+            const auto& o = opts<UIWidgets::FloatSliderOptions>(w);
+            float v = o.defaultValue;
+            if (w.type == GdxUI::WIDGET_CVAR_SLIDER_FLOAT) {
+                v = CVarGetFloat(w.cVar, o.defaultValue);
+            } else if (float* p = ptr<float>(w)) {
+                v = *p;
+            }
+            return formatted(o.format, o.isPercentage ? v * 100.f : v, false);
+        }
+        case GdxUI::WIDGET_CVAR_RADIO_BUTTON:
+            return CVarGetInteger(w.cVar, 0) == w.radioValue ? ICON_FA_CHECK : "";
+        case GdxUI::WIDGET_BUTTON:
+            return ICON_FA_ANGLE_RIGHT;
+        default:
+            return "";
+    }
+}
+
+// dir -1/+1 from Left/Right, 0 from Cross. True when the value changed (or a button ran).
+bool widgetChange(GdxUI::WidgetInfo& w, int dir) {
+    bool changed = false;
+    switch (w.type) {
+        case GdxUI::WIDGET_CVAR_CHECKBOX:
+            CVarSetInteger(w.cVar, !CVarGetInteger(w.cVar, opts<UIWidgets::CheckboxOptions>(w).defaultValue));
+            changed = true;
+            break;
+        case GdxUI::WIDGET_CHECKBOX:
+            if (bool* v = ptr<bool>(w)) {
+                *v = !*v;
+                changed = true;
+            }
+            break;
+        case GdxUI::WIDGET_COMBOBOX:
+        case GdxUI::WIDGET_CVAR_COMBOBOX: {
+            const auto rows = comboRows(w);
+            if (rows.empty()) {
+                break;
+            }
+            const int32_t v = comboValue(w);
+            int at = 0;
+            for (int i = 0; i < (int)rows.size(); i++) {
+                if (rows[i].first == v) {
+                    at = i;
+                }
+            }
+            const int n = (int)rows.size();
+            const int32_t next = rows[((at + (dir == 0 ? 1 : dir)) % n + n) % n].first;
+            if (w.type == GdxUI::WIDGET_CVAR_COMBOBOX) {
+                CVarSetInteger(w.cVar, next);
+            } else if (int32_t* v = ptr<int32_t>(w)) {
+                *v = next;
+            }
+            changed = true;
+            break;
+        }
+        case GdxUI::WIDGET_CVAR_SLIDER_INT:
+        case GdxUI::WIDGET_SLIDER_INT: {
+            if (dir == 0) {
+                break;
+            }
+            const auto& o = opts<UIWidgets::IntSliderOptions>(w);
+            int32_t* p = w.type == GdxUI::WIDGET_SLIDER_INT ? ptr<int32_t>(w) : nullptr;
+            const int32_t v = p != nullptr ? *p : CVarGetInteger(w.cVar, o.defaultValue);
+            const int32_t next = std::clamp(v + dir * std::max(o.step, 1), o.min, o.max);
+            if (next != v) {
+                if (p != nullptr) {
+                    *p = next;
+                } else if (w.type == GdxUI::WIDGET_CVAR_SLIDER_INT) {
+                    CVarSetInteger(w.cVar, next);
+                }
+                changed = p != nullptr || w.type == GdxUI::WIDGET_CVAR_SLIDER_INT;
+            }
+            break;
+        }
+        case GdxUI::WIDGET_CVAR_SLIDER_FLOAT:
+        case GdxUI::WIDGET_SLIDER_FLOAT: {
+            if (dir == 0) {
+                break;
+            }
+            const auto& o = opts<UIWidgets::FloatSliderOptions>(w);
+            float* p = w.type == GdxUI::WIDGET_SLIDER_FLOAT ? ptr<float>(w) : nullptr;
+            const float v = p != nullptr ? *p : CVarGetFloat(w.cVar, o.defaultValue);
+            const float step = o.step > 0 ? o.step : .01f;
+            // snap to the step so repeated nudges don't drift (UIWidgets does the same)
+            const float next = std::clamp(std::round((v + dir * step) / step) * step, o.min, o.max);
+            if (next != v) {
+                if (p != nullptr) {
+                    *p = next;
+                    changed = true;
+                } else if (w.type == GdxUI::WIDGET_CVAR_SLIDER_FLOAT) {
+                    CVarSetFloat(w.cVar, next);
+                    changed = true;
+                }
+            }
+            break;
+        }
+        case GdxUI::WIDGET_CVAR_RADIO_BUTTON:
+            if (CVarGetInteger(w.cVar, 0) != w.radioValue) {
+                CVarSetInteger(w.cVar, w.radioValue);
+                changed = true;
+            }
+            break;
+        case GdxUI::WIDGET_BUTTON:
+            changed = dir == 0;
+            break;
+        default:
+            break;
+    }
+    if (changed && w.callback != nullptr) {
+        w.callback(w);
+    }
+    return changed;
+}
+
+// ------------------------------------------------------------------------------------------------
+// The menu
+// ------------------------------------------------------------------------------------------------
+
+enum Row { RESUME, RESET, VOLUME, FPS, WIDESCREEN, SETTINGS, ENHANCEMENTS, CLOSE, ROWS };
+
+enum class State { Closed, Open, Leaving };
+State gState = State::Closed;
+MenuInput gIn;
+int gSel;
+float gPos, gVel;
+float gOpenedAt;
+bool gChanged;
+bool gInSettings;
+int gSection; // 0 Settings, 1 Enhancements
+int gGroup, gOpt;
+float gOptPos, gOptVel, gScroll;
+ImTextureID gFrozen;
+uint32_t gComboPrev;
+bool gQuitRequested;
+// Debounce: the touchpad click (and L3+R3) chatters, and each bounce toggled the menu, which then
+// flashed open and shut. A press counts only after the buttons were let go for a while.
+float gComboReleasedAt = -10.f;
+bool gComboHeld;
+
+void open(float t, uint32_t buttons) {
+    gState = State::Open;
+    gSel = RESUME;
+    gPos = 0;
+    gVel = 0;
+    gOpenedAt = t;
+    gChanged = false;
+    gInSettings = false;
+    gIn.reset(buttons);
+    if (auto vk = vulkan()) {
+        gFrozen = vk->CaptureLastFrame();
+    }
+    soundStart();
+    playSound(Sound::Category);
+    gdx_port_logf("[quickmenu] opened\n");
+}
+
+void leave() {
+    if (gChanged) {
+        CVarSave();
+    }
+    gState = State::Leaving;
+}
+
+} // namespace
+
+bool GdxPs4QuickMenuUpdate() {
+    float lx, ly;
+    const uint32_t buttons = padButtons(lx, ly);
+    const float t = nowSeconds();
+    gComboPrev = buttons;
+    // the touchpad, or L3+R3 together; a new press only after both were let go for 0.3 s
+    const bool comboDown = (buttons & P_TOUCHPAD) || (buttons & (P_L3 | P_R3)) == (P_L3 | P_R3);
+    bool combo = false;
+    if (comboDown && !gComboHeld) {
+        combo = t - gComboReleasedAt >= .3f;
+        gComboHeld = true;
+    } else if (!comboDown && gComboHeld) {
+        gComboHeld = false;
+        gComboReleasedAt = t;
+    }
+
+    switch (gState) {
+        case State::Closed:
+            if (combo) {
+                if (enhancementsVisible()) {
+                    // the full G-Diffuser menu is up: the touchpad closes it
+                    setEnhancementsVisible(false);
+                    playSound(Sound::Back);
+                    return false;
+                }
+                open(t, buttons);
+                return true;
+            }
+            return false;
+        case State::Open:
+            gIn.read(buttons, lx, ly, t);
+            // the touchpad closes it too, but not in its first half second (the opening press)
+            if (combo && t - gOpenedAt >= .5f) {
+                playSound(Sound::Back);
+                leave();
+            }
+            return true;
+        case State::Leaving:
+            // the game resumes once Cross/Circle are let go, so the press isn't seen by it too
+            if ((buttons & (P_CROSS | P_CIRCLE | P_TOUCHPAD | P_L3 | P_R3)) != 0) {
+                return true;
+            }
+            gState = State::Closed;
+            gdx_port_logf("[quickmenu] closed\n");
+            if (gQuitRequested) {
+                soundStop();
+                if (auto w = window()) {
+                    w->Close();
+                }
+            }
+            return false;
+    }
+    return false;
+}
+
+void GdxPs4QuickMenuDraw() {
+    Frame f = menuFrame();
+    ImDrawList* dl = f.dl;
+    // the paused game
+    if (gFrozen != nullptr) {
+        dl->AddImage(gFrozen, ImVec2(0, 0), ImVec2(f.w, f.h));
+    } else {
+        dl->AddRectFilled(ImVec2(0, 0), ImVec2(f.w, f.h), IM_COL32(0, 0, 0, 255));
+    }
+    const float in = gState == State::Open ? easeOut((f.t - gOpenedAt) / .25f) : 1.f;
+
+    // ---- input ----
+    if (gState == State::Open) {
+        if (gInSettings) {
+            if (auto menu = gdxMenu()) {
+                menu->QuickMenuEvaluate();
+            }
+            const auto& ps = pages(gSection);
+            const std::vector<Item> items = ps.empty() ? std::vector<Item>{} : pageItems(ps[gGroup]);
+            // the selection skips headings; the first control when the page changed under it
+            const auto selectable = [&](int i) { return i >= 0 && i < (int)items.size() && !items[i].heading; };
+            if (!selectable(gOpt)) {
+                gOpt = 0;
+                while (gOpt < (int)items.size() && !selectable(gOpt)) {
+                    gOpt++;
+                }
+            }
+            if (gIn.circle) {
+                gInSettings = false;
+                playSound(Sound::Back);
+            } else if ((gIn.l1 || gIn.r1) && ps.size() > 1) {
+                gGroup = (gGroup + (gIn.r1 ? 1 : -1) + (int)ps.size()) % (int)ps.size();
+                gOpt = -1;
+                gOptPos = 0;
+                gScroll = 0;
+                playSound(Sound::Category);
+            } else if (gIn.dy != 0 && !items.empty()) {
+                int next = gOpt;
+                for (int k = 0; k < (int)items.size(); k++) {
+                    next = (next + gIn.dy + (int)items.size()) % (int)items.size();
+                    if (selectable(next)) {
+                        break;
+                    }
+                }
+                if (selectable(next) && next != gOpt) {
+                    gOpt = next;
+                    playSound(Sound::Move);
+                }
+            } else if ((gIn.dx != 0 || gIn.cross) && selectable(gOpt)) {
+                if (items[gOpt].disabled) {
+                    playSound(Sound::Back);
+                } else if (widgetChange(*items[gOpt].w, gIn.dx)) {
+                    gChanged = true;
+                    playSound(items[gOpt].w->type == GdxUI::WIDGET_BUTTON ? Sound::Confirm : Sound::Move);
+                }
+            }
+        } else {
+            if (gIn.dy != 0) {
+                gSel = (gSel + gIn.dy + ROWS) % ROWS;
+                playSound(Sound::Move);
+            }
+            if (gIn.dx != 0) {
+                switch (gSel) {
+                    case VOLUME:
+                        CVarSetInteger("gEnhancements.Audio.MasterVolume",
+                                       std::clamp(CVarGetInteger("gEnhancements.Audio.MasterVolume", 100) + gIn.dx * 10, 0,
+                                                  100));
+                        gChanged = true;
+                        playSound(Sound::Move);
+                        break;
+                    case FPS:
+                        toggleFps();
+                        playSound(Sound::Move);
+                        break;
+                    case WIDESCREEN:
+                        CVarSetInteger("gEnhancements.Graphics.Widescreen",
+                                       !CVarGetInteger("gEnhancements.Graphics.Widescreen", 1));
+                        gChanged = true;
+                        playSound(Sound::Move);
+                        break;
+                }
+            }
+            if (gIn.cross) {
+                switch (gSel) {
+                    case RESUME:
+                        playSound(Sound::Back);
+                        leave();
+                        break;
+                    case RESET:
+                        playSound(Sound::Confirm);
+                        gdx_game_request_reset();
+                        leave();
+                        break;
+                    case VOLUME:
+                        break;
+                    case FPS:
+                        toggleFps();
+                        playSound(Sound::Move);
+                        break;
+                    case WIDESCREEN:
+                        CVarSetInteger("gEnhancements.Graphics.Widescreen",
+                                       !CVarGetInteger("gEnhancements.Graphics.Widescreen", 1));
+                        gChanged = true;
+                        playSound(Sound::Move);
+                        break;
+                    case SETTINGS:
+                    case ENHANCEMENTS:
+                        if (pages(gSel == SETTINGS ? 0 : 1).empty()) {
+                            playSound(Sound::Back);
+                            break;
+                        }
+                        playSound(Sound::Confirm);
+                        gInSettings = true;
+                        gSection = gSel == SETTINGS ? 0 : 1;
+                        gGroup = 0;
+                        gOpt = -1;
+                        gOptPos = 0;
+                        gOptVel = 0;
+                        gScroll = 0;
+                        break;
+                    case CLOSE:
+                        playSound(Sound::Back);
+                        gQuitRequested = true;
+                        leave();
+                        break;
+                }
+            }
+            if (gIn.circle) {
+                playSound(Sound::Back);
+                leave();
+            }
+        }
+    }
+
+    // ---- the paused game behind a side panel ----
+    const float panelW = f.w * .4f;
+    const float slide = (1 - in) * -panelW * .3f;
+    const ImU32 dark = IM_COL32(4, 8, 18, (int)(235 * in)), mid = IM_COL32(4, 8, 18, (int)(150 * in)),
+                clear = IM_COL32(4, 8, 18, 0);
+    dl->AddRectFilled(ImVec2(0, 0), ImVec2(f.w, f.h), IM_COL32(0, 0, 0, (int)(70 * in)));
+    dl->AddRectFilledMultiColor(ImVec2(0, 0), ImVec2(panelW, f.h), dark, mid, mid, dark);
+    dl->AddRectFilledMultiColor(ImVec2(panelW, 0), ImVec2(panelW + f.w * .15f, f.h), mid, clear, clear, mid);
+    const Color tone = xmbTone();
+    dl->AddRectFilled(ImVec2(panelW - 2 + slide, 0), ImVec2(panelW + slide, f.h), tone.u32(.6f * in));
+
+    // logo, game, PAUSED
+    const float x = f.w * .05f + slide;
+    const float coverH = f.h * .1f;
+    const float headY = f.h * .135f;
+    xmbText(dl, bodyFont(), f.h * .034f, ImVec2(x, f.h * .055f), in * .95f, "G-DIFFUSER");
+    dl->AddRectFilledMultiColor(ImVec2(x, headY), ImVec2(x + coverH, headY + coverH), tone.u32(in),
+                                mix(tone, { 0, 0, 0 }, .5f).u32(in), mix(tone, { 0, 0, 0 }, .7f).u32(in),
+                                mix(tone, { 1, 1, 1 }, .2f).u32(in));
+    xmbText(dl, bodyFont(), coverH * .55f, ImVec2(x + coverH * .5f, headY + coverH * .2f), in, ICON_FA_FLAG_CHECKERED,
+            .5f);
+    const float tx = x + coverH + f.w * .015f;
+    const float pill = f.h * .02f;
+    const std::string paused = "PAUSED";
+    const float pw = textWidth(bodyFont(), pill, paused) + pill * 1.4f;
+    const float pulse = .75f + .25f * std::sin(f.t * 3.f);
+    dl->AddRectFilled(ImVec2(tx, headY + f.h * .005f), ImVec2(tx + pw, headY + f.h * .005f + pill * 1.6f),
+                      tone.u32(.9f * in * pulse), pill * .8f);
+    xmbText(dl, bodyFont(), pill, ImVec2(tx + pill * .7f, headY + f.h * .005f + pill * .28f), in, paused);
+    xmbText(dl, bodyFont(), f.h * .032f, ImVec2(tx, headY + f.h * .005f + pill * 2.3f), in, "F-Zero X", 0,
+            panelW - (tx - slide) - f.w * .02f);
+
+    // the rows
+    spring(gPos, gVel, (float)gSel, 170.f, 26.f, f.dt);
+    struct RowView {
+        const char* icon;
+        std::string label, value;
+        bool arrows;
+    };
+    const int volume = CVarGetInteger("gEnhancements.Audio.MasterVolume", 100);
+    const RowView rows[ROWS] = {
+        { ICON_FA_PLAY, "Resume", "", false },
+        { ICON_FA_REFRESH, "Reset Game", "", false },
+        { ICON_FA_VOLUME_UP, "Volume Level", std::to_string(volume) + "%", true },
+        { ICON_FA_TACHOMETER, "Show FPS Counter", fpsShown() ? "On" : "Off", true },
+        { ICON_FA_TELEVISION, "Widescreen", CVarGetInteger("gEnhancements.Graphics.Widescreen", 1) ? "On" : "Off", true },
+        { ICON_FA_COG, "Settings", "", false },
+        { ICON_FA_SLIDERS, "Enhancements", "", false },
+        { ICON_FA_POWER_OFF, "Close Game", "", false },
+    };
+    const float rowH = f.h * .068f, top = f.h * .27f;
+    const float rx0 = x - f.w * .01f, rx1 = panelW - f.w * .025f + slide;
+    const float listAlpha = gInSettings ? .45f : 1.f;
+    // the highlight glides between rows
+    const float hy = top + gPos * rowH;
+    dl->AddRectFilledMultiColor(ImVec2(rx0, hy), ImVec2(rx1, hy + rowH), tone.u32(.55f * in * listAlpha),
+                                tone.u32(.12f * in * listAlpha), tone.u32(.12f * in * listAlpha),
+                                tone.u32(.55f * in * listAlpha));
+    dl->AddRectFilled(ImVec2(rx0, hy), ImVec2(rx0 + 4, hy + rowH), IM_COL32(255, 255, 255, (int)(230 * in * listAlpha)));
+    const float ts = f.h * .029f;
+    for (int i = 0; i < ROWS; i++) {
+        const RowView& r = rows[i];
+        const float y = top + i * rowH;
+        const float a = in * listAlpha * (i == gSel ? 1.f : .82f);
+        const float ty = y + (rowH - ts) * .5f;
+        xmbText(dl, bodyFont(), ts * .95f, ImVec2(x + ts * .7f, ty), a, r.icon, .5f);
+        xmbText(dl, bodyFont(), ts, ImVec2(x + ts * 2.f, ty), a, r.label);
+        if (!r.value.empty()) {
+            std::string v = r.value;
+            if (r.arrows && i == gSel && !gInSettings) {
+                v = std::string(ICON_FA_CARET_LEFT "  ") + v + "  " ICON_FA_CARET_RIGHT;
+            }
+            xmbText(dl, bodyFont(), ts * .9f, ImVec2(rx1 - f.w * .01f, ty), a, v, 1.f);
+        }
+    }
+
+    // ---- settings, beside the panel ----
+    if (gInSettings) {
+        const auto& ps = pages(gSection);
+        const std::vector<Item> items = ps.empty() ? std::vector<Item>{} : pageItems(ps[gGroup]);
+        const float sx0 = panelW + f.w * .05f, sx1 = f.w * .95f;
+        // the page: section, name, and where it sits among the others
+        const std::string section = gSection == 0 ? "SETTINGS" : "ENHANCEMENTS";
+        xmbText(dl, bodyFont(), ts * .7f, ImVec2(sx0, f.h * .155f), in * .7f, section);
+        const std::string name = ps.empty() ? "" : ps[gGroup].sidebar;
+        const float nameW = textWidth(bodyFont(), ts * 1.1f, name) + ts * 1.6f;
+        dl->AddRectFilled(ImVec2(sx0, f.h * .19f), ImVec2(sx0 + nameW, f.h * .19f + ts * 1.9f), tone.u32(.75f * in),
+                          ts * .95f);
+        xmbText(dl, bodyFont(), ts * 1.1f, ImVec2(sx0 + ts * .8f, f.h * .19f + ts * .35f), in, name);
+        if (ps.size() > 1) {
+            const std::string where = std::to_string(gGroup + 1) + " / " + std::to_string(ps.size());
+            xmbText(dl, bodyFont(), ts * .8f, ImVec2(sx1, f.h * .19f + ts * .5f), in * .7f, where, 1.f);
+        }
+
+        // the rows, scrolled to keep the selection in view
+        const float oRowH = f.h * .056f;
+        const float sTop = f.h * .27f, sBottom = f.h * .80f;
+        const int visible = std::max(1, (int)((sBottom - sTop) / oRowH));
+        const int sel = std::max(gOpt, 0);
+        float want = gScroll;
+        if (sel < want + 1) {
+            want = (float)std::max(0, sel - 1);
+        } else if (sel > want + visible - 2) {
+            want = (float)std::min(sel - visible + 2, std::max(0, (int)items.size() - visible));
+        }
+        gScroll = want;
+        spring(gOptPos, gOptVel, (float)sel, 170.f, 26.f, f.dt);
+        dl->AddRectFilled(ImVec2(sx0, sTop - f.h * .01f),
+                          ImVec2(sx1, sTop + std::min((int)items.size(), visible) * oRowH + f.h * .01f),
+                          IM_COL32(4, 8, 18, (int)(170 * in)), 8.f);
+        dl->PushClipRect(ImVec2(sx0, sTop - f.h * .01f), ImVec2(sx1, sTop + visible * oRowH + f.h * .01f), true);
+        if (!items.empty()) {
+            const float shy = sTop + (gOptPos - gScroll) * oRowH;
+            dl->AddRectFilledMultiColor(ImVec2(sx0, shy), ImVec2(sx1, shy + oRowH), tone.u32(.55f * in),
+                                        tone.u32(.12f * in), tone.u32(.12f * in), tone.u32(.55f * in));
+            dl->AddRectFilled(ImVec2(sx0, shy), ImVec2(sx0 + 4, shy + oRowH),
+                              IM_COL32(255, 255, 255, (int)(230 * in)));
+        }
+        const float ots = ts * .92f;
+        const float valueW = (sx1 - sx0) * .36f;
+        for (int i = (int)gScroll; i < (int)items.size() && i < (int)gScroll + visible + 1; i++) {
+            const Item& it = items[i];
+            const float y = sTop + (i - gScroll) * oRowH;
+            const float ty = y + (oRowH - ots) * .5f;
+            if (it.heading) {
+                xmbText(dl, bodyFont(), ots * .8f, ImVec2(sx0 + ots * .8f, ty + ots * .15f), in * .75f,
+                        it.w->name, 0, 0, tone.u32(1.f));
+                continue;
+            }
+            const float a = in * (it.disabled ? .38f : (i == gOpt ? 1.f : .82f));
+            xmbText(dl, bodyFont(), ots, ImVec2(sx0 + ots * 1.3f, ty), a, it.w->name, 0,
+                    (sx1 - sx0) - valueW - ots * 2.f);
+            std::string v = widgetValue(*it.w);
+            const bool arrows = it.w->type != GdxUI::WIDGET_BUTTON && it.w->type != GdxUI::WIDGET_CVAR_RADIO_BUTTON;
+            if (i == gOpt && arrows && !it.disabled) {
+                v = std::string(ICON_FA_CARET_LEFT "  ") + v + "  " ICON_FA_CARET_RIGHT;
+            }
+            xmbText(dl, bodyFont(), ots * .9f, ImVec2(sx1 - ots * .8f, ty), a, v, 1.f, valueW);
+        }
+        dl->PopClipRect();
+        if ((int)items.size() > visible) {
+            // a scroll bar along the right edge
+            const float trackH = visible * oRowH;
+            const float barH = std::max(trackH * visible / items.size(), oRowH * .6f);
+            const float barY = sTop + (trackH - barH) * (gScroll / std::max(1, (int)items.size() - visible));
+            dl->AddRectFilled(ImVec2(sx1 + 6, barY), ImVec2(sx1 + 10, barY + barH),
+                              IM_COL32(255, 255, 255, (int)(140 * in)), 2.f);
+        }
+
+        // what the selected control does: its tooltip, or why it is greyed out
+        if (gOpt >= 0 && gOpt < (int)items.size()) {
+            const GdxUI::WidgetInfo& w = *items[gOpt].w;
+            const char* text = nullptr;
+            if (items[gOpt].disabled) {
+                text = "Not available right now.";
+            } else if (w.options != nullptr && w.options->tooltip != nullptr && *w.options->tooltip) {
+                text = w.options->tooltip;
+            }
+            if (text != nullptr) {
+                std::string flat = text;
+                std::replace(flat.begin(), flat.end(), '\n', ' ');
+                dl->AddText(bodyFont(), ts * .72f, ImVec2(sx0 + 2, sBottom + f.h * .025f),
+                            IM_COL32(220, 228, 240, (int)(210 * in)), flat.c_str(), nullptr, sx1 - sx0);
+            }
+        }
+    }
+
+    xmbClock(f, in);
+    if (gInSettings) {
+        xmbHints(f, { { 'l', "" }, { 'r', "Page" }, { 'x', "Change" }, { 'o', "Back" } }, in);
+    } else {
+        xmbHints(f, { { 'x', "Select" }, { 'o', "Resume" } }, in);
+    }
+}
