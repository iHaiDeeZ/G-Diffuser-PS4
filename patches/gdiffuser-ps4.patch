+// port/ps4/ps4_platform.cpp -- PS4 startup: the data directory and the packaged game data.
+//
+// The package carries the game data the PC version's first boot built (fzerox.o2r,
+// fzerox-disk.o2r, n64ddipl.o2r, the setup/extraction state files) plus the engine archive and
+// fonts, under /app0/gdiffuser. /app0 is read-only and G-Diffuser keeps everything in one
+// writable folder, so they are copied to /data/gdiffuser: once, and again whenever a packaged
+// file's size changes (a newer package). Saves, config and logs are only ever created there.
+#include <algorithm>
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <string>
+#include <system_error>
+
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <SDL2/SDL.h>
+
+namespace fs = std::filesystem;
+
+extern "C" __attribute__((weak)) void ps4_boot_trace(const char* line); // port/ps4_crashlog.cpp
+
+namespace {
+
+const char* const kPackaged = "/app0/gdiffuser";
+const char* const kData = "/data/gdiffuser";
+
+void Trace(const std::string& line) {
+    if (ps4_boot_trace != nullptr) {
+        ps4_boot_trace((line + "\n").c_str());
+    }
+}
+
+// Setup and extraction state: copied when absent only, so the console's own state wins.
+bool IsStateFile(const std::string& rel) {
+    const std::string name = fs::path(rel).filename().string();
+    return name == "gdx_firstboot.cfg" || name == "gdx_extract_state.cfg";
+}
+
+// Plain POSIX I/O: libc++'s fs::copy_file also copies the permission bits, which /data refuses
+// ("Permission denied" on the console), and fs::relative gave empty paths there.
+bool CopyFile(const std::string& from, const std::string& to) {
+    std::error_code ec;
+    fs::create_directories(fs::path(to).parent_path(), ec);
+    const std::string partial = to + ".partial";
+    const int in = open(from.c_str(), O_RDONLY);
+    if (in < 0) {
+        Trace("ps4: open " + from + " failed: " + strerror(errno));
+        return false;
+    }
+    const int out = open(partial.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (out < 0) {
+        Trace("ps4: create " + partial + " failed: " + strerror(errno));
+        close(in);
+        return false;
+    }
+    static char buffer[1 << 20];
+    bool ok = true;
+    for (;;) {
+        const ssize_t n = read(in, buffer, sizeof(buffer));
+        if (n == 0) {
+            break;
+        }
+        if (n < 0 || write(out, buffer, (size_t)n) != n) {
+            Trace("ps4: copy " + from + " failed: " + strerror(errno));
+            ok = false;
+            break;
+        }
+    }
+    close(in);
+    if (close(out) != 0) {
+        ok = false;
+    }
+    if (ok && rename(partial.c_str(), to.c_str()) != 0) {
+        Trace("ps4: rename " + partial + " failed: " + strerror(errno));
+        ok = false;
+    }
+    if (!ok) {
+        unlink(partial.c_str());
+    }
+    return ok;
+}
+
+off_t FileSize(const std::string& path) {
+    struct stat st;
+    return stat(path.c_str(), &st) == 0 ? st.st_size : (off_t)-1;
+}
+
+} // namespace
+
+// DualShock 4 through SDL's PS4 joystick driver (PacBrew SDL 2.0.18): buttons are numbered like
+// SDL's game controller layout except that Options and the touchpad sit in the Back and Start
+// slots (DolphinPS4 / SRB2-PS4), and the D-pad is hat 0. SDL's own mapping for the pad follows
+// that numbering, which put Options on Back (G-Diffuser's menu) and the touchpad on Start, so the
+// mapping is always replaced: Options = Start (the game's pause), touchpad = Back (the quick menu).
+extern "C" void gdx_ps4_init_controllers(void) {
+    char line[256];
+    for (int i = 0; i < SDL_NumJoysticks(); i++) {
+        char guid[64];
+        SDL_JoystickGetGUIDString(SDL_JoystickGetDeviceGUID(i), guid, sizeof(guid));
+        const bool known = SDL_IsGameController(i);
+        snprintf(line, sizeof(line), "ps4: joystick %d \"%s\" guid %s, %s", i, SDL_JoystickNameForIndex(i), guid,
+                 known ? "replacing its mapping with the DualShock 4 one" : "adding a DualShock 4 mapping");
+        Trace(line);
+        {
+            std::string mapping = std::string(guid) +
+                                  ",DualShock 4 (PS4),a:b0,b:b1,x:b2,y:b3,start:b4,guide:b5,back:b6,"
+                                  "leftstick:b7,rightstick:b8,leftshoulder:b9,rightshoulder:b10,"
+                                  "dpup:h0.1,dpright:h0.2,dpdown:h0.4,dpleft:h0.8,"
+                                  "leftx:a0,lefty:a1,rightx:a2,righty:a3,lefttrigger:a4,righttrigger:a5,";
+            if (SDL_GameControllerAddMapping(mapping.c_str()) < 0) {
+                Trace(std::string("ps4: SDL_GameControllerAddMapping failed: ") + SDL_GetError());
+            }
+        }
+        if (SDL_Joystick* js = SDL_JoystickOpen(i)) {
+            snprintf(line, sizeof(line), "ps4: joystick %d: %d axes, %d buttons, %d hats", i, SDL_JoystickNumAxes(js),
+                     SDL_JoystickNumButtons(js), SDL_JoystickNumHats(js));
+            Trace(line);
+            SDL_JoystickClose(js);
+        }
+    }
+}
+
+// getcwd fails on the console, which makes std::filesystem::current_path() and absolute() of a
+// relative path throw. The working directory is only ever set once, by gdx_ps4_prepare_data, so
+// the wrapper (linked with --wrap=getcwd) answers with it when the real call fails.
+extern "C" char* __real_getcwd(char* buf, size_t size);
+extern "C" char* __wrap_getcwd(char* buf, size_t size) {
+    char* r = __real_getcwd(buf, size);
+    if (r != nullptr) {
+        return r;
+    }
+    const size_t need = strlen(kData) + 1;
+    if (buf == nullptr) {
+        buf = (char*)malloc(size > need ? size : need);
+        if (buf == nullptr) {
+            errno = ENOMEM;
+            return nullptr;
+        }
+    } else if (size < need) {
+        errno = ERANGE;
+        return nullptr;
+    }
+    memcpy(buf, kData, need);
+    return buf;
+}
+
+// The port finds its game folder through readlink("/proc/self/exe") in several places
+// (gdx_firstboot, sram/disk/rom buffers, the log path); the PS4 has no /proc. Answer with an
+// eboot path inside the game folder (--wrap=readlink).
+extern "C" ssize_t __real_readlink(const char* path, char* buf, size_t size);
+extern "C" ssize_t __wrap_readlink(const char* path, char* buf, size_t size) {
+    if (path != nullptr && strcmp(path, "/proc/self/exe") == 0) {
+        const std::string exe = std::string(kData) + "/eboot.bin";
+        const size_t n = std::min(exe.size(), size);
+        memcpy(buf, exe.data(), n);
+        return (ssize_t)n;
+    }
+    return __real_readlink(path, buf, size);
+}
+
+extern "C" const char* gdx_ps4_data_dir(void) {
+    return kData;
+}
+
+extern "C" void gdx_ps4_prepare_data(void) {
+    std::error_code ec;
+    fs::create_directories(fs::path(kData) / "saves", ec);
+    fs::create_directories(fs::path(kData) / "logs", ec);
+
+    unsigned copied = 0, kept = 0, failed = 0;
+    uintmax_t bytes = 0;
+    const std::string prefix = std::string(kPackaged) + "/";
+    if (fs::is_directory(kPackaged, ec)) {
+        for (auto it = fs::recursive_directory_iterator(kPackaged, ec); !ec && it != fs::recursive_directory_iterator();
+             it.increment(ec)) {
+            const std::string src = it->path().string();
+            if (it->is_directory(ec) || src.compare(0, prefix.size(), prefix) != 0) {
+                continue;
+            }
+            const std::string rel = src.substr(prefix.size());
+            const std::string dst = std::string(kData) + "/" + rel;
+            const off_t size = FileSize(src);
+            const off_t have = FileSize(dst);
+            if (have >= 0 && (IsStateFile(rel) || have == size)) {
+                kept++;
+                continue;
+            }
+            if (CopyFile(src, dst)) {
+                copied++;
+                bytes += (uintmax_t)size;
+            } else {
+                failed++;
+            }
+        }
+    } else {
+        Trace("ps4: no packaged game data in /app0/gdiffuser");
+    }
+    char line[160];
+    snprintf(line, sizeof(line), "ps4: game data: %u file(s) copied (%llu KiB), %u up to date, %u failed",
+             copied, (unsigned long long)(bytes / 1024), kept, failed);
+    Trace(line);
+
+    if (chdir(kData) != 0) {
+        Trace(std::string("ps4: chdir /data/gdiffuser failed: ") + strerror(errno));
+    }
+}
