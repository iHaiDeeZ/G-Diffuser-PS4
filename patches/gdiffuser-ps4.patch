+ * (0x03004618 = machine_custom_gfx/D_3004618). On PS4 the image sits below 4 GiB, so such a
+ * segment address can also be a valid image address (that one lands in gAudioHeap). Returns the
+ * placeholder holding segment address `raw` (symbol + interior offset), preferring an exact symbol
+ * start, or NULL when no asset row has that segment address. */
+void* gdx_asset_symbol_for_segment_address(unsigned int raw) {
+    const unsigned char seg = (unsigned char)(raw >> 24);
+    const unsigned int off = raw & 0x00FFFFFFu;
+    int i;
+    int interior = -1;
+    for (i = 0; sAssetSegmentMap[i].sym != NULL; i++) {
+        const GdxAssetSegmentEntry* e = &sAssetSegmentMap[i];
+        if (e->segment != seg || off < e->offset || off - e->offset >= e->sym_size) {
+            continue;
+        }
+        if (off == e->offset) {
+            return e->sym;
+        }
+        if (interior < 0) {
+            interior = i;
+        }
+    }
+    if (interior >= 0) {
+        return (unsigned char*)sAssetSegmentMap[interior].sym + (off - sAssetSegmentMap[interior].offset);
+    }
+    return NULL;
