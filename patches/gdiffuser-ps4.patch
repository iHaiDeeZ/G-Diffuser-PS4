+namespace {
+
+constexpr float PI = 3.14159265f;
+
+// ------------------------------------------------------------------------------------------------
+// Style (Resonance xmb_style.cpp / launcher.cpp)
+// ------------------------------------------------------------------------------------------------
+
+struct Color {
+    float r = 0, g = 0, b = 0;
+    ImU32 u32(float a = 1.f) const {
+        auto c = [](float v) { return (int)std::lround(std::fmin(1.f, std::fmax(0.f, v)) * 255.f); };
+        return IM_COL32(c(r), c(g), c(b), c(a));
+    }
+};
+
+Color mix(const Color& a, const Color& b, float t) {
+    return { a.r + (b.r - a.r) * t, a.g + (b.g - a.g) * t, a.b + (b.b - a.b) * t };
+}
+
+float clamp01(float t) {
+    return std::fmin(1.f, std::fmax(0.f, t));
+}
+
+float easeOut(float t) {
+    t = clamp01(t);
+    return 1.f - (1.f - t) * (1.f - t) * (1.f - t);
+}
+
+void spring(float& pos, float& vel, float goal, float stiffness, float damping, float dt) {
+    // a few sub-steps keep stiff springs stable at low frame rates
+    for (int i = 0; i < 4; i++) {
+        const float h = dt / 4;
+        vel += (stiffness * (goal - pos) - damping * vel) * h;
+        pos += vel * h;
+    }
+}
+
+// The console's time zone (homebrew's localtime() is UTC), re-read once a minute.
+long utcOffset() {
+    static long offset;
+    static time_t readAt;
+    const time_t now = time(nullptr);
+    if (readAt == 0 || now - readAt >= 60 || now < readAt) {
+        int32_t zone = 0, summer = 0;
+        if (sceSystemServiceParamGetInt(ORBIS_SYSTEM_SERVICE_PARAM_ID_TIME_ZONE, &zone) != 0) {
+            zone = 0;
+        }
+        if (sceSystemServiceParamGetInt(ORBIS_SYSTEM_SERVICE_PARAM_ID_SUMMERTIME, &summer) != 0) {
+            summer = 0;
+        }
+        offset = (long)zone * 60 + (summer ? 3600 : 0);
+        readAt = now;
+    }
+    return offset;
+}
+
+const struct tm* localTm(time_t t) {
+    static struct tm out;
+    const time_t local = t + utcOffset();
+    const struct tm* g = gmtime(&local);
+    if (g == nullptr) {
+        return nullptr;
+    }
+    out = *g;
+    return &out;
+}
+
+Color xmbTone() {
+    // January silver, February gold, March lime, April pink, May green, June violet, July teal,
+    // August blue, September purple, October amber, November brown, December red
+    static const Color months[12] = {
+        { .62f, .64f, .70f }, { .80f, .64f, .16f }, { .46f, .66f, .16f }, { .84f, .42f, .60f },
+        { .14f, .56f, .26f }, { .56f, .34f, .76f }, { .10f, .56f, .64f }, { .16f, .38f, .82f },
+        { .44f, .24f, .66f }, { .76f, .56f, .12f }, { .52f, .32f, .18f }, { .74f, .14f, .16f },
+    };
+    const tm* lt = localTm(time(nullptr));
+    return months[lt != nullptr ? lt->tm_mon % 12 : 7];
+}
+
+struct Frame {
+    ImDrawList* dl;
+    float w, h; // screen size
+    float t, dt; // seconds since the menu module started, frame time
+};
+
+// Seconds since the module started. Safe outside an ImGui frame (GdxPs4QuickMenuUpdate runs
+// before Gui::StartDraw, where there is no draw list yet).
+float nowSeconds() {
+    static auto start = std::chrono::steady_clock::now();
+    return std::chrono::duration<float>(std::chrono::steady_clock::now() - start).count();
+}
+
+// Only inside the ImGui frame (GdxPs4QuickMenuDraw).
+Frame menuFrame() {
+    ImGuiIO& io = ImGui::GetIO();
+    Frame f{};
+    f.dl = ImGui::GetForegroundDrawList();
+    f.w = io.DisplaySize.x;
+    f.h = io.DisplaySize.y;
+    f.t = nowSeconds();
+    f.dt = std::min(.05f, io.DeltaTime);
+    return f;
+}
+
+ImFont* bodyFont() {
+    ImFont* font = GdxGuiFontQuickMenu();
+    return font != nullptr ? font : ImGui::GetFont();
+}
+
+float textWidth(ImFont* font, float size, const std::string& text) {
+    return font->CalcTextSizeA(size, FLT_MAX, 0.f, text.c_str()).x;
+}
+
+float drawText(ImDrawList* dl, ImFont* font, float size, ImVec2 pos, ImU32 col, const std::string& text,
+               float align = 0.f, float maxWidth = 0.f) {
+    std::string s = text;
+    float width = textWidth(font, size, s);
+    if (maxWidth > 0 && width > maxWidth) {
+        const std::string dots = "...";
+        while (!s.empty() && textWidth(font, size, s + dots) > maxWidth) {
+            s.pop_back();
+            while (!s.empty() && ((unsigned char)s.back() & 0xC0) == 0x80) { // whole UTF-8 characters
+                s.pop_back();
+            }
+        }
+        s += dots;
+        width = textWidth(font, size, s);
+    }
+    dl->AddText(font, size, ImVec2(std::round(pos.x - width * align), std::round(pos.y)), col, s.c_str());
+    return width;
+}
+
+// White text with a soft shadow
+float xmbText(ImDrawList* dl, ImFont* font, float size, ImVec2 pos, float alpha, const std::string& text,
+              float align = 0.f, float maxWidth = 0.f, ImU32 color = IM_COL32(255, 255, 255, 255)) {
+    if (alpha <= 0) {
+        return 0;
+    }
+    const float off = std::max(1.f, size * .06f);
+    drawText(dl, font, size, ImVec2(pos.x + off, pos.y + off), IM_COL32(0, 0, 0, (int)(110 * alpha)), text, align,
+             maxWidth);
+    const ImU32 c =
+        (color & ~IM_COL32_A_MASK) | ((ImU32)(((color >> IM_COL32_A_SHIFT) & 0xff) * alpha) << IM_COL32_A_SHIFT);
+    return drawText(dl, font, size, pos, c, text, align, maxWidth);
+}
+
+// The PS button symbols: 'x' cross, 'o' circle, 's' square, 't' triangle, 'l' L1, 'r' R1
+void drawButton(ImDrawList* dl, char which, ImVec2 c, float size, float alpha) {
+    const float r = size * .5f, t = std::fmax(1.5f, size * .1f);
+    dl->AddCircleFilled(c, r, IM_COL32(20, 24, 34, (int)(200 * alpha)));
+    const float k = r * .48f;
+    switch (which) {
+        case 'x': {
+            const ImU32 col = IM_COL32(120, 170, 255, (int)(255 * alpha));
+            dl->AddLine(ImVec2(c.x - k, c.y - k), ImVec2(c.x + k, c.y + k), col, t);
+            dl->AddLine(ImVec2(c.x - k, c.y + k), ImVec2(c.x + k, c.y - k), col, t);
+            break;
+        }
+        case 'o':
+            dl->AddCircle(c, k * 1.05f, IM_COL32(255, 100, 110, (int)(255 * alpha)), 24, t);
+            break;
+        case 's':
+            dl->AddRect(ImVec2(c.x - k * .9f, c.y - k * .9f), ImVec2(c.x + k * .9f, c.y + k * .9f),
+                        IM_COL32(240, 140, 220, (int)(255 * alpha)), 0, 0, t);
+            break;
+        case 't':
+            dl->AddTriangle(ImVec2(c.x, c.y - k * 1.05f), ImVec2(c.x + k * 1.05f, c.y + k * .75f),
+                            ImVec2(c.x - k * 1.05f, c.y + k * .75f), IM_COL32(90, 220, 180, (int)(255 * alpha)), t);
+            break;
+        case 'l':
+        case 'r':
+            drawText(dl, bodyFont(), size * .46f, ImVec2(c.x, c.y - size * .3f), IM_COL32(230, 234, 242, (int)(255 * alpha)),
+                     which == 'l' ? "L1" : "R1", .5f);
+            break;
+    }
+}
+
+void xmbClock(Frame& f, float alpha) {
+    char clock[32];
+    const tm* lt = localTm(time(nullptr));
+    if (lt == nullptr) {
+        return;
+    }
+    strftime(clock, sizeof(clock), "%d/%m  %H:%M", lt);
+    const float size = f.h * .026f;
+    const float w = xmbText(f.dl, bodyFont(), size, ImVec2(f.w * .94f, f.h * .055f), alpha, clock, 1.f);
+    // the PS3's little clock face beside it
+    const ImVec2 c(f.w * .94f - w - size * .9f, f.h * .055f + size * .55f);
+    f.dl->AddCircle(c, size * .45f, IM_COL32(255, 255, 255, (int)(220 * alpha)), 20, 1.5f);
+    const float h = (lt->tm_hour % 12 + lt->tm_min / 60.f) / 12.f * 2 * PI, m = lt->tm_min / 60.f * 2 * PI;
+    f.dl->AddLine(c, ImVec2(c.x + std::sin(h) * size * .25f, c.y - std::cos(h) * size * .25f),
+                  IM_COL32(255, 255, 255, (int)(220 * alpha)), 1.5f);
+    f.dl->AddLine(c, ImVec2(c.x + std::sin(m) * size * .36f, c.y - std::cos(m) * size * .36f),
+                  IM_COL32(255, 255, 255, (int)(220 * alpha)), 1.5f);
+}
+
+struct Hint {
+    char button;
+    std::string label;
+};
+
+// Button hints at the bottom right
+void xmbHints(Frame& f, const std::vector<Hint>& hints, float alpha) {
+    if (alpha <= 0) {
+        return;
+    }
+    ImFont* font = bodyFont();
+    const float size = f.h * .028f, fs = f.h * .022f, y = f.h * .935f, gap = size * .5f;
+    float total = 0;
+    for (const Hint& h : hints) {
+        total += size + gap + textWidth(font, fs, h.label) + size * 1.2f;
+    }
+    float x = f.w * .94f - total;
+    for (const Hint& h : hints) {
+        drawButton(f.dl, h.button, ImVec2(x + size / 2, y), size, alpha);
+        x += size + gap;
+        x += xmbText(f.dl, font, fs, ImVec2(x, y - fs * .62f), alpha * .9f, h.label);
+        x += size * 1.2f;
+    }
+}
+
+// ------------------------------------------------------------------------------------------------
+// Sounds (Resonance sound.cpp): PCM WAVs mixed on a small sceAudioOut port of their own
+// ------------------------------------------------------------------------------------------------
+
+enum class Sound { Move, Category, Confirm, Launch, Back, Error };
+
+constexpr int32_t kSystemUser = 0xFF;
+constexpr uint32_t kGrain = 256;
+constexpr int SOUND_COUNT = 6;
+constexpr int VOICES = 6;
+const char* const kSoundNames[SOUND_COUNT] = { "move", "category", "confirm", "launch", "back", "error" };
+const float kGain[SOUND_COUNT] = { .45f, .55f, .6f, .7f, .5f, .55f };
+
+std::vector<int16_t> gClips[SOUND_COUNT]; // interleaved stereo
+bool gClipsLoaded;
+struct Voice {
+    int clip = -1;
+    size_t pos = 0;
+};
+std::mutex gSoundMutex;
+Voice gVoices[VOICES];
+std::atomic<bool> gSoundRunning;
+std::thread gSoundThread;
+int32_t gSoundPort = -1;
+
+uint32_t le32(const uint8_t* p) {
+    return p[0] | (p[1] << 8) | (p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+uint16_t le16(const uint8_t* p) {
+    return p[0] | (p[1] << 8);
+}
+
+// PCM 16-bit WAV, mono or stereo, into interleaved stereo
+bool loadWav(const std::string& path, std::vector<int16_t>& out) {
+    FILE* f = fopen(path.c_str(), "rb");
+    if (f == nullptr) {
+        return false;
+    }
+    std::vector<uint8_t> file;
+    uint8_t buf[8192];
+    size_t n;
+    while ((n = fread(buf, 1, sizeof(buf), f)) > 0) {
+        file.insert(file.end(), buf, buf + n);
+    }
+    fclose(f);
+    if (file.size() < 12 || memcmp(&file[0], "RIFF", 4) || memcmp(&file[8], "WAVE", 4)) {
+        return false;
+    }
+    int channels = 0, bits = 0;
+    size_t p = 12;
+    while (p + 8 <= file.size()) {
+        const uint32_t size = le32(&file[p + 4]);
+        const size_t body = p + 8;
+        if (body + size > file.size()) {
+            break;
+        }
+        if (!memcmp(&file[p], "fmt ", 4) && size >= 16) {
+            channels = le16(&file[body + 2]);
+            bits = le16(&file[body + 14]);
+        } else if (!memcmp(&file[p], "data", 4) && bits == 16 && (channels == 1 || channels == 2)) {
+            const size_t frames = size / (2 * channels);
+            out.resize(frames * 2);
+            for (size_t i = 0; i < frames; i++) {
+                const int16_t l = (int16_t)le16(&file[body + i * 2 * channels]);
+                out[i * 2] = l;
+                out[i * 2 + 1] = channels == 2 ? (int16_t)le16(&file[body + i * 4 + 2]) : l;
+            }
+            return true;
+        }
+        p = body + size + (size & 1);
+    }
+    return false;
+}
+
+void soundLoop() {
+    alignas(64) int16_t out[kGrain * 2];
+    float mixBuf[kGrain * 2];
+    while (gSoundRunning) {
+        std::fill(std::begin(mixBuf), std::end(mixBuf), 0.f);
+        {
+            std::lock_guard<std::mutex> lock(gSoundMutex);
+            for (Voice& v : gVoices) {
+                if (v.clip < 0) {
+                    continue;
+                }
+                const std::vector<int16_t>& clip = gClips[v.clip];
+                const float gain = kGain[v.clip];
+                const size_t n = std::min<size_t>(kGrain * 2, clip.size() - v.pos);
+                for (size_t i = 0; i < n; i++) {
+                    mixBuf[i] += clip[v.pos + i] * gain;
+                }
+                v.pos += n;
+                if (v.pos >= clip.size()) {
+                    v.clip = -1;
+                }
+            }
+        }
+        for (uint32_t i = 0; i < kGrain * 2; i++) {
+            out[i] = (int16_t)std::clamp(mixBuf[i], -32768.f, 32767.f);
+        }
+        sceAudioOutOutput(gSoundPort, out); // blocks for one grain
+    }
+    sceAudioOutOutput(gSoundPort, nullptr); // wait for the last grain
+}
+
+void soundStart() {
+    if (gSoundRunning) {
+        return;
+    }
+    if (!gClipsLoaded) {
+        gClipsLoaded = true;
+        for (int i = 0; i < SOUND_COUNT; i++) {
+            loadWav(std::string("/data/gdiffuser/quickmenu/sounds/") + kSoundNames[i] + ".wav", gClips[i]);
+        }
+    }
+    const int32_t init = sceAudioOutInit();
+    if (init != 0 && init != (int32_t)0x8026000E) { // already initialized (SDL's audio)
+        return;
+    }
+    gSoundPort = sceAudioOutOpen(kSystemUser, ORBIS_AUDIO_OUT_PORT_TYPE_MAIN, 0, kGrain, 48000,
+                                 ORBIS_AUDIO_OUT_PARAM_FORMAT_S16_STEREO);
+    if (gSoundPort < 0) {
+        return;
+    }
+    int32_t volume[2] = { 32768, 32768 };
+    sceAudioOutSetVolume(gSoundPort, 0x3, volume);
+    gSoundRunning = true;
+    gSoundThread = std::thread(soundLoop);
+}
+
+void soundStop() {
+    if (!gSoundRunning) {
+        return;
+    }
+    gSoundRunning = false;
+    if (gSoundThread.joinable()) {
+        gSoundThread.join();
+    }
+    sceAudioOutClose(gSoundPort);
+    gSoundPort = -1;
+    std::lock_guard<std::mutex> lock(gSoundMutex);
+    for (Voice& v : gVoices) {
+        v.clip = -1;
+    }
+}
+
+void playSound(Sound s) {
+    const int clip = (int)s;
+    if (!gSoundRunning || clip < 0 || clip >= SOUND_COUNT || gClips[clip].empty()) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(gSoundMutex);
+    // a free voice, else the one closest to its end
+    Voice* best = &gVoices[0];
+    for (Voice& v : gVoices) {
+        if (v.clip < 0) {
+            best = &v;
+            break;
+        }
+        if (v.pos > best->pos) {
+            best = &v;
+        }
+    }
+    best->clip = clip;
+    best->pos = 0;
+}
+
+// ------------------------------------------------------------------------------------------------
+// The pad (SDL game controller, DualShock 4 mapping from port/ps4/ps4_platform.cpp)
+// ------------------------------------------------------------------------------------------------
+
+SDL_GameController* gPad;
+
+SDL_GameController* pad() {
+    if (gPad != nullptr && SDL_GameControllerGetAttached(gPad)) {
+        return gPad;
+    }
+    if (gPad != nullptr) {
+        SDL_GameControllerClose(gPad);
+        gPad = nullptr;
+    }
+    for (int i = 0; i < SDL_NumJoysticks(); i++) {
+        if (SDL_IsGameController(i) && (gPad = SDL_GameControllerOpen(i)) != nullptr) {
+            break;
+        }
+    }
+    return gPad;
+}
+
+enum PadBit : uint32_t {
+    P_CROSS = 1 << 0,
+    P_CIRCLE = 1 << 1,
+    P_SQUARE = 1 << 2,
+    P_TRIANGLE = 1 << 3,
+    P_L1 = 1 << 4,
+    P_R1 = 1 << 5,
+    P_UP = 1 << 6,
+    P_DOWN = 1 << 7,
+    P_LEFT = 1 << 8,
+    P_RIGHT = 1 << 9,
+    P_TOUCHPAD = 1 << 10,
+    P_L3 = 1 << 11,
+    P_R3 = 1 << 12,
+};
+
+uint32_t padButtons(float& lx, float& ly) {
+    lx = ly = 0;
+    SDL_GameController* c = pad();
+    if (c == nullptr) {
+        return 0;
+    }
+    auto b = [c](SDL_GameControllerButton button) { return SDL_GameControllerGetButton(c, button) != 0; };
+    uint32_t out = 0;
+    out |= b(SDL_CONTROLLER_BUTTON_A) ? P_CROSS : 0;
+    out |= b(SDL_CONTROLLER_BUTTON_B) ? P_CIRCLE : 0;
+    out |= b(SDL_CONTROLLER_BUTTON_X) ? P_SQUARE : 0;
+    out |= b(SDL_CONTROLLER_BUTTON_Y) ? P_TRIANGLE : 0;
+    out |= b(SDL_CONTROLLER_BUTTON_LEFTSHOULDER) ? P_L1 : 0;
+    out |= b(SDL_CONTROLLER_BUTTON_RIGHTSHOULDER) ? P_R1 : 0;
+    out |= b(SDL_CONTROLLER_BUTTON_DPAD_UP) ? P_UP : 0;
+    out |= b(SDL_CONTROLLER_BUTTON_DPAD_DOWN) ? P_DOWN : 0;
+    out |= b(SDL_CONTROLLER_BUTTON_DPAD_LEFT) ? P_LEFT : 0;
+    out |= b(SDL_CONTROLLER_BUTTON_DPAD_RIGHT) ? P_RIGHT : 0;
+    out |= b(SDL_CONTROLLER_BUTTON_BACK) ? P_TOUCHPAD : 0;
+    out |= b(SDL_CONTROLLER_BUTTON_LEFTSTICK) ? P_L3 : 0;
+    out |= b(SDL_CONTROLLER_BUTTON_RIGHTSTICK) ? P_R3 : 0;
+    lx = SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_LEFTX) / 32767.f;
+    ly = SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_LEFTY) / 32767.f;
+    return out;
+}
+
+// The pad for menus: new presses, held directions with repeat (Resonance's MenuInput). Buttons
+// already down when the menu (re)appears aren't new presses in it.
+struct MenuInput {
+    int dx = 0, dy = 0;
+    bool cross = false, circle = false, triangle = false, square = false, l1 = false, r1 = false;
+    bool touchpad = false;
+
+    // Also clears the one-shot presses: the last read before the menu closed (the Cross that hit
+    // Resume) would otherwise still be set on the first draw after reopening and close it at once.
+    void reset(uint32_t buttons) {
+        prev = buttons;
+        held = -1;
+        dx = dy = 0;
+        cross = circle = triangle = square = l1 = r1 = touchpad = false;
+    }
+
+    void read(uint32_t buttons, float lx, float ly, float t) {
+        const uint32_t pressed = buttons & ~prev;
+        prev = buttons;
+        cross = pressed & P_CROSS;
+        circle = pressed & P_CIRCLE;
+        triangle = pressed & P_TRIANGLE;
+        square = pressed & P_SQUARE;
+        l1 = pressed & P_L1;
+        r1 = pressed & P_R1;
+        touchpad = pressed & P_TOUCHPAD;
+        int dir = 0;
+        if ((buttons & P_LEFT) || lx < -.55f) {
+            dir = 1;
+        } else if ((buttons & P_RIGHT) || lx > .55f) {
+            dir = 2;
+        } else if ((buttons & P_UP) || ly < -.55f) {
+            dir = 3;
+        } else if ((buttons & P_DOWN) || ly > .55f) {
+            dir = 4;
+        }
+        dx = dy = 0;
+        if (held == -1) {
+            // wait for a direction held across the change to be let go
+            if (dir == 0) {
+                held = 0;
+            }
+            return;
+        }
+        bool fire = false;
+        if (dir != held) {
+            held = dir;
+            fire = dir != 0;
+            repeatAt = t + .38f;
+        } else if (dir != 0 && t >= repeatAt) {
+            fire = true;
+            repeatAt = t + .085f;
+        }
+        if (fire) {
+            dx = dir == 1 ? -1 : dir == 2 ? 1 : 0;
+            dy = dir == 3 ? -1 : dir == 4 ? 1 : 0;
+        }
+    }
+
+  private:
+    uint32_t prev = 0;
+    int held = -1;
+    float repeatAt = 0;
+};
