+// port/ps4/quick_menu.h -- the PS4 quick menu (Resonance's, adapted): touchpad or L3+R3 during the
+// game pauses it behind a PS3-style side panel.
+#pragma once
+
+// Once per host frame, before the game ticks: reads the pad, opens/closes the menu. True while the
+// menu is up (the game is paused: the frame loop presents only the menu over the frozen frame).
+bool GdxPs4QuickMenuUpdate();
+
+// Inside the ImGui frame (between Gui::StartDraw and EndDraw) while GdxPs4QuickMenuUpdate is true.
+void GdxPs4QuickMenuDraw();
