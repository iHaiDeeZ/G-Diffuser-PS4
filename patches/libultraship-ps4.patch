+// Fast3D on Vulkan for the PS4 (see gfx_vulkan.h).
+//
+// Frame structure. The interpreter drives one present per Run(): StartFrame, draws into an
+// offscreen framebuffer or straight into framebuffer 0, the GUI composites into framebuffer 0,
+// then EndFrame -> FinishRender. Commands are recorded into two command buffers per frame:
+// `upload` (texture uploads and first-use layout transitions; uploads arrive in the middle of
+// render passes, where copies are not allowed) and `cmd` (everything else). Both go to the queue
+// in one submission, upload first, and FinishRender queues the VideoOut flip behind them.
+//
+// Layouts. Render-target color images (including the VideoOut buffers) stay in GENERAL, so they
+// can be sampled, copied and drawn to without transitions; the render passes' external
+// dependencies order the writes against later reads. Textures are SHADER_READ_ONLY_OPTIMAL,
+// depth images DEPTH_STENCIL_ATTACHMENT_OPTIMAL.
+//
+// Shaders. The OpenGL backend's template (shaders/opengl/default.shader.glsl) is expanded with
+// GLSL 4.50 settings and then rewritten for Vulkan: explicit locations for inputs and varyings,
+// fixed sampler bindings (texture unit = binding), and the loose uniforms replaced by one push
+// constant block. glslang compiles the result to SPIR-V; RADV/ACO compiles that on the console.
+#ifdef ENABLE_VULKAN
+
+#ifndef VK_NO_PROTOTYPES
+#define VK_NO_PROTOTYPES
+#endif
+#include "fast/backends/gfx_vulkan.h"
+#include "fast/backends/gfx_vulkan_shader.h"
+
+#include <vulkan/vulkan_core.h>
+
+#define VMA_STATIC_VULKAN_FUNCTIONS 0
+#define VMA_DYNAMIC_VULKAN_FUNCTIONS 1
+#define VMA_IMPLEMENTATION
+#include <vk_mem_alloc.h>
