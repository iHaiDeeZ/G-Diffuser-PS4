+std::unordered_map<std::pair<float, float>, uint16_t, hash_pair_ff>
+GfxRenderingAPIVulkan::GetPixelDepth(int fb_id, const std::set<std::pair<float, float>>& coordinates) {
+    VulkanState& s = *mState;
+    std::unordered_map<std::pair<float, float>, uint16_t, hash_pair_ff> res;
+    if (fb_id < 0 || fb_id >= (int)s.framebuffers.size() || coordinates.empty()) {
+        return res;
+    }
+    Framebuffer& fb = s.framebuffers[fb_id];
+    if (!fb.hasDepth || fb.depth == VK_NULL_HANDLE) {
+        for (const auto& c : coordinates) {
+            res.emplace(c, 0);
+        }
+        return res;
+    }
+    s.BeginFrame();
+    s.EndRenderPass();
+    const VkDeviceSize size = coordinates.size() * 4;
+    if (s.readback.size < size) {
+        if (s.readback.buffer != VK_NULL_HANDLE) {
+            vmaDestroyBuffer(s.allocator, s.readback.buffer, s.readback.alloc);
+        }
+        s.readback = s.CreateHostBuffer(std::max<VkDeviceSize>(size, 4096), VK_BUFFER_USAGE_TRANSFER_DST_BIT, true);
+    }
+    std::vector<VkBufferImageCopy> regions;
+    regions.reserve(coordinates.size());
+    for (const auto& c : coordinates) {
+        VkBufferImageCopy r = {};
+        r.bufferOffset = regions.size() * 4;
+        r.imageSubresource = { VK_IMAGE_ASPECT_DEPTH_BIT, 0, 0, 1 };
+        // The interpreter's coordinates are OpenGL's (origin bottom-left); images are top-down.
+        const int x = std::clamp((int)c.first, 0, (int)fb.width - 1);
+        const int y = std::clamp((int)fb.height - 1 - (int)c.second, 0, (int)fb.height - 1);
+        r.imageOffset = { x, y, 0 };
+        r.imageExtent = { 1, 1, 1 };
+        regions.push_back(r);
+    }
+    VkCommandBuffer cb = s.F().cmd;
+    s.Barrier(cb, fb.depth, VK_IMAGE_ASPECT_DEPTH_BIT, VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL,
+              VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT,
+              VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+              VK_ACCESS_TRANSFER_READ_BIT);
+    vkCmdCopyImageToBuffer(cb, fb.depth, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, s.readback.buffer,
+                           (uint32_t)regions.size(), regions.data());
+    s.Barrier(cb, fb.depth, VK_IMAGE_ASPECT_DEPTH_BIT, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+              VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL, VK_PIPELINE_STAGE_TRANSFER_BIT, 0,
+              VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT | VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT,
+              VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT);
+    s.MemoryBarrier(cb, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, VK_PIPELINE_STAGE_HOST_BIT,
+                    VK_ACCESS_HOST_READ_BIT);
+    s.SubmitAndWait();
+    vmaInvalidateAllocation(s.allocator, s.readback.alloc, 0, VK_WHOLE_SIZE);
+    const float* depths = (const float*)s.readback.map;
+    size_t i = 0;
+    for (const auto& c : coordinates) {
+        res.emplace(c, (uint16_t)(depths[i++] * 65532.0f));
+    }
+    return res;
+}
