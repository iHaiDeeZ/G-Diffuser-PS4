--- /dev/null
+++ b/src/ship/audio/Ps4AudioPlayer.cpp
@@ -0,0 +1,141 @@
+#ifdef __ORBIS__
+#include "ship/audio/Ps4AudioPlayer.h"
+
+#include <orbis/AudioOut.h>
+#include <spdlog/spdlog.h>
+
+#include <algorithm>
+#include <cstring>
+
+extern "C" __attribute__((weak)) void ps4_boot_trace(const char* line); // port/ps4 boot-trace.log
+
+namespace Ship {
+
+namespace {
+constexpr int32_t kSystemUser = 0xFF;
+constexpr uint32_t kOutRate = 48000; // the only rate sceAudioOut takes
+constexpr uint32_t kGrain = 256;     // output frames per sceAudioOutOutput
+constexpr size_t kRingFrames = 16384;
+
+void trace(const char* line) {
+    if (ps4_boot_trace != nullptr) {
+        ps4_boot_trace(line);
+    }
+}
+} // namespace
+
+Ps4AudioPlayer::~Ps4AudioPlayer() {
+    DoClose();
+}
+
+bool Ps4AudioPlayer::DoInit() {
+    mNumChannels = GetNumOutputChannels();
+    const int32_t init = sceAudioOutInit();
+    if (init != 0 && init != (int32_t)0x8026000E) { // 0x8026000E: already initialized
+        char line[96];
+        snprintf(line, sizeof(line), "[audio] sceAudioOutInit failed: %#x\n", (unsigned)init);
+        trace(line);
+        return false;
+    }
+    mPort = sceAudioOutOpen(kSystemUser, ORBIS_AUDIO_OUT_PORT_TYPE_MAIN, 0, kGrain, kOutRate,
+                            ORBIS_AUDIO_OUT_PARAM_FORMAT_S16_STEREO);
+    if (mPort < 0) {
+        char line[96];
+        snprintf(line, sizeof(line), "[audio] sceAudioOutOpen failed: %#x\n", (unsigned)mPort);
+        trace(line);
+        mPort = -1;
+        return false;
+    }
+    int32_t volume[2] = { 32768, 32768 };
+    sceAudioOutSetVolume(mPort, 0x3, volume);
+    {
+        std::lock_guard<std::mutex> lock(mMutex);
+        mRing.assign(kRingFrames * 2, 0);
+        mRead = 0;
+        mCount = 0;
+    }
+    mRunning = true;
+    mThread = std::thread(&Ps4AudioPlayer::OutputLoop, this);
+    char line[128];
+    snprintf(line, sizeof(line), "[audio] sceAudioOut port %d: %d Hz game stream -> %u Hz, %d channel(s) in\n", mPort,
+             GetSampleRate(), kOutRate, mNumChannels);
+    trace(line);
+    return true;
+}
+
+void Ps4AudioPlayer::DoClose() {
+    if (mRunning.exchange(false) && mThread.joinable()) {
+        mThread.join();
+    }
+    if (mPort >= 0) {
+        sceAudioOutClose(mPort);
+        mPort = -1;
+    }
+}
+
+int Ps4AudioPlayer::Buffered() {
+    std::lock_guard<std::mutex> lock(mMutex);
+    return (int)mCount;
+}
+
+void Ps4AudioPlayer::DoPlay(const uint8_t* buf, size_t len) {
+    const int16_t* in = reinterpret_cast<const int16_t*>(buf);
+    const size_t frames = len / (sizeof(int16_t) * mNumChannels);
+    std::lock_guard<std::mutex> lock(mMutex);
+    if (mRing.empty()) {
+        return;
+    }
+    for (size_t i = 0; i < frames && mCount < kRingFrames; i++) {
+        const int16_t* f = in + i * mNumChannels;
+        int32_t l = f[0], r = f[1];
+        if (mNumChannels == 6) {
+            // FL FR C LFE SL SR: fold centre and surrounds back to stereo
+            l = f[0] + (f[2] * 7 / 10) + (f[4] * 7 / 10);
+            r = f[1] + (f[2] * 7 / 10) + (f[5] * 7 / 10);
+        }
+        const size_t w = (mRead + mCount) % kRingFrames;
+        mRing[w * 2] = (int16_t)std::clamp(l, -32768, 32767);
+        mRing[w * 2 + 1] = (int16_t)std::clamp(r, -32768, 32767);
+        mCount++;
+    }
+}
+
+void Ps4AudioPlayer::OutputLoop() {
+    alignas(64) int16_t out[kGrain * 2];
+    const uint32_t inRate = (uint32_t)std::max(GetSampleRate(), 1);
+    // 16.16 fixed-point step through the input per output frame
+    const uint64_t step = ((uint64_t)inRate << 16) / kOutRate;
+    uint64_t frac = 0;
+    int16_t lastL = 0, lastR = 0;
+    while (mRunning) {
+        {
+            std::lock_guard<std::mutex> lock(mMutex);
+            for (uint32_t i = 0; i < kGrain; i++) {
+                if (mCount < 2) {
+                    // underrun: hold the last sample, decaying, rather than click
+                    lastL = (int16_t)(lastL * 31 / 32);
+                    lastR = (int16_t)(lastR * 31 / 32);
+                    out[i * 2] = lastL;
+                    out[i * 2 + 1] = lastR;
+                    continue;
+                }
+                const size_t a = mRead % kRingFrames, b = (mRead + 1) % kRingFrames;
+                const int32_t t = (int32_t)(frac & 0xFFFF);
+                const int32_t l = mRing[a * 2] + (((mRing[b * 2] - mRing[a * 2]) * t) >> 16);
+                const int32_t r = mRing[a * 2 + 1] + (((mRing[b * 2 + 1] - mRing[a * 2 + 1]) * t) >> 16);
+                out[i * 2] = lastL = (int16_t)l;
+                out[i * 2 + 1] = lastR = (int16_t)r;
+                frac += step;
+                const size_t advance = (size_t)(frac >> 16);
+                frac &= 0xFFFF;
+                mRead = (mRead + advance) % kRingFrames;
+                mCount -= std::min(mCount, advance);
+            }
+        }
+        sceAudioOutOutput(mPort, out); // blocks for one grain
+    }
+    sceAudioOutOutput(mPort, nullptr); // wait for the last grain
+}
