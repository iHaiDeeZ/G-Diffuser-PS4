+void GfxRenderingAPIVulkan::SetViewport(int x, int y, int width, int height) {
+    VulkanState& s = *mState;
+    // OpenGL-style rectangle (origin bottom-left) -> a flipped Vulkan viewport over a top-down
+    // render target: y runs from the rectangle's bottom edge upwards.
+    s.viewport.x = (float)x;
+    s.viewport.y = (float)((int)s.renderTargetHeight - y);
+    s.viewport.width = (float)width;
+    s.viewport.height = -(float)height;
+    s.viewport.minDepth = 0.0f;
+    s.viewport.maxDepth = 1.0f;
+    s.viewportDirty = true;
+}
+
+void GfxRenderingAPIVulkan::SetScissor(int x, int y, int width, int height) {
+    VulkanState& s = *mState;
+    int top = (int)s.renderTargetHeight - y - height;
+    int left = x;
+    int right = x + width;
+    int bottom = top + height;
+    left = std::clamp(left, 0, (int)s.renderTargetWidth);
+    right = std::clamp(right, 0, (int)s.renderTargetWidth);
+    top = std::clamp(top, 0, (int)s.renderTargetHeight);
+    bottom = std::clamp(bottom, 0, (int)s.renderTargetHeight);
+    s.scissor.offset = { left, top };
+    s.scissor.extent = { (uint32_t)std::max(right - left, 0), (uint32_t)std::max(bottom - top, 0) };
+    s.scissorDirty = true;
+}
