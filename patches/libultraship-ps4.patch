+void* GfxRenderingAPIVulkan::GetFramebufferTextureId(int fbId) {
+    VulkanState& s = *mState;
+    if (fbId <= 0 || fbId >= (int)s.framebuffers.size()) {
+        return nullptr;
+    }
+    {
+        const int upscaled = GdxFsrUpscale(this, s, fbId);
+        if (upscaled > 0) {
+            fbId = upscaled;
+        }
+    }
+    VkTex& t = s.textures[s.framebuffers[fbId].colorTex];
+    if (t.view == VK_NULL_HANDLE) {
+        return nullptr;
+    }
+    if (t.imgui == VK_NULL_HANDLE) {
+        t.imgui = ImGui_ImplVulkan_AddTexture(s.imguiSampler, t.view, VK_IMAGE_LAYOUT_GENERAL);
+    }
+    return (void*)t.imgui;
+}
+
+void GfxRenderingAPIVulkan::SelectTextureFb(int fbId) {
+    VulkanState& s = *mState;
+    if (fbId <= 0 || fbId >= (int)s.framebuffers.size()) {
+        return;
+    }
+    const uint32_t tex = s.framebuffers[fbId].colorTex;
+    SelectTexture(0, tex);
+    VkTex& t = s.textures[tex];
+    // What SetSamplerParameters(0, true, G_TX_WRAP, G_TX_WRAP) gives, as in the OpenGL backend.
+    t.linear = true;
+    t.cms = t.cmt = G_TX_WRAP;
+    t.filtering = FILTER_THREE_POINT;
+}
+
+void GfxRenderingAPIVulkan::ReadFramebufferToCPU(int fbId, uint32_t width, uint32_t height, uint16_t* rgba16Buf) {
+    VulkanState& s = *mState;
+    if (fbId < 0 || fbId >= (int)s.framebuffers.size() || width == 0 || height == 0) {
+        return;
+    }
+    Framebuffer& fb = s.framebuffers[fbId];
+    VkImage image = s.ColorImage(fbId);
+    if (image == VK_NULL_HANDLE) {
+        return;
+    }
+    s.BeginFrame();
+    s.EndRenderPass();
+    const VkDeviceSize size = (VkDeviceSize)fb.width * fb.height * 4;
+    if (s.readback.size < size) {
+        if (s.readback.buffer != VK_NULL_HANDLE) {
+            vmaDestroyBuffer(s.allocator, s.readback.buffer, s.readback.alloc);
+        }
+        s.readback = s.CreateHostBuffer(size, VK_BUFFER_USAGE_TRANSFER_DST_BIT, true);
+    }
+    VkCommandBuffer cb = s.F().cmd;
+    s.MemoryBarrier(cb, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                    VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT,
+                    VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT);
+    VkBufferImageCopy region = {};
+    region.imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+    region.imageExtent = { fb.width, fb.height, 1 };
+    vkCmdCopyImageToBuffer(cb, image, VK_IMAGE_LAYOUT_GENERAL, s.readback.buffer, 1, &region);
+    s.MemoryBarrier(cb, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, VK_PIPELINE_STAGE_HOST_BIT,
+                    VK_ACCESS_HOST_READ_BIT);
+    s.SubmitAndWait();
+    vmaInvalidateAllocation(s.allocator, s.readback.alloc, 0, VK_WHOLE_SIZE);
+
+    // Box-filter downscale into RGBA5551 with the coverage bit set, as the D3D11 backend does.
+    const uint32_t srcW = fb.width, srcH = fb.height;
+    const uint32_t* pixels = (const uint32_t*)s.readback.map;
+    for (uint32_t j = 0; j < height; j++) {
+        uint32_t sy0 = j * srcH / height, sy1 = (j + 1) * srcH / height;
+        if (sy1 <= sy0) {
+            sy1 = sy0 + 1;
+        }
+        sy1 = std::min(sy1, srcH);
+        for (uint32_t i = 0; i < width; i++) {
+            uint32_t sx0 = i * srcW / width, sx1 = (i + 1) * srcW / width;
+            if (sx1 <= sx0) {
+                sx1 = sx0 + 1;
+            }
+            sx1 = std::min(sx1, srcW);
+            uint32_t accR = 0, accG = 0, accB = 0, count = 0;
+            for (uint32_t sy = sy0; sy < sy1; sy++) {
+                const uint32_t* row = pixels + (size_t)sy * srcW;
+                for (uint32_t sx = sx0; sx < sx1; sx++) {
+                    const uint32_t p = row[sx];
+                    accR += p & 0xFF;
+                    accG += (p >> 8) & 0xFF;
+                    accB += (p >> 16) & 0xFF;
+                    ++count;
+                }
+            }
+            const uint32_t r = count ? accR / count : 0, g = count ? accG / count : 0, b = count ? accB / count : 0;
+            const uint8_t r5 = ((r + 4) * 0x1F) / 0xFF;
+            const uint8_t g5 = ((g + 4) * 0x1F) / 0xFF;
+            const uint8_t b5 = ((b + 4) * 0x1F) / 0xFF;
+            rgba16Buf[i + j * width] = (r5 << 11) | (g5 << 6) | (b5 << 1) | 1;
+        }
+    }
+}
