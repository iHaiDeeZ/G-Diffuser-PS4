+void GfxRenderingAPIVulkan::ImGuiInit() {
+    VulkanState& s = *mState;
+    ImGui_ImplVulkan_LoadFunctions(
+        VK_API_VERSION_1_1,
+        [](const char* name, void* user) -> PFN_vkVoidFunction {
+            VulkanState* st = (VulkanState*)user;
+            PFN_vkVoidFunction fn = vkGetDeviceProcAddr(st->device, name);
+            if (fn == nullptr) {
+                fn = vk_icdGetInstanceProcAddr(st->instance, name);
+            }
+            return fn != nullptr ? fn : (PFN_vkVoidFunction)MissingVulkanFunction;
+        },
+        &s);
+    ImGui_ImplVulkan_InitInfo info = {};
+    info.ApiVersion = VK_API_VERSION_1_1;
+    info.Instance = s.instance;
+    info.PhysicalDevice = s.gpu;
+    info.Device = s.device;
+    info.QueueFamily = s.queueFamily;
+    info.Queue = s.queue;
+    info.DescriptorPoolSize = 1024;
+    info.RenderPass = s.renderPass[1];
+    info.MinImageCount = 2;
+    info.ImageCount = kSwapImages;
+    info.MSAASamples = VK_SAMPLE_COUNT_1_BIT;
+    info.PipelineCache = s.pipelineCache;
+    info.CheckVkResultFn = [](VkResult r) {
+        if (r != VK_SUCCESS) {
+            Trace("ImGui Vulkan error %d", (int)r);
+        }
+    };
+    ImGui_ImplVulkan_Init(&info);
+    Trace("ImGui Vulkan backend ready");
+}
+
+void GfxRenderingAPIVulkan::ImGuiShutdown() {
+    if (mState->device != VK_NULL_HANDLE) {
+        vkDeviceWaitIdle(mState->device);
+    }
+    ImGui_ImplVulkan_Shutdown();
+}
+
+void GfxRenderingAPIVulkan::ImGuiNewFrame() {
+    ImGui_ImplVulkan_NewFrame();
+}
+
+void GfxRenderingAPIVulkan::ImGuiRender(ImDrawData* data) {
+    VulkanState& s = *mState;
+    const int previousFb = s.currentFb;
+    StartDrawToFramebuffer(0, 0.0f);
+    s.EnsureRenderPass();
+    if (s.inRenderPass) {
+        ImGui_ImplVulkan_RenderDrawData(data, s.F().cmd);
+    }
+    // ImGui changed the pipeline, descriptor set and dynamic state.
+    s.boundPipeline = VK_NULL_HANDLE;
+    s.boundSet = VK_NULL_HANDLE;
+    s.viewportDirty = s.scissorDirty = s.depthBiasDirty = true;
+    StartDrawToFramebuffer(previousFb, 0.0f);
+}
