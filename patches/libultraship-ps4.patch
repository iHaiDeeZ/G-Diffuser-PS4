+void Trace(const char* fmt, ...) __attribute__((format(printf, 1, 2)));
+void Trace(const char* fmt, ...) {
+    char line[512];
+    va_list args;
+    va_start(args, fmt);
+    vsnprintf(line, sizeof(line), fmt, args);
+    va_end(args);
+    SPDLOG_INFO("[vulkan] {}", line);
+    if (ps4_boot_trace != nullptr) {
+        std::string withNewline = std::string("vulkan: ") + line + "\n";
+        ps4_boot_trace(withNewline.c_str());
+    }
+}
+
+#define VK_CHECK(call)                                                                            \
+    do {                                                                                          \
+        VkResult r_ = (call);                                                                     \
+        if (r_ != VK_SUCCESS) {                                                                   \
+            Trace("%s failed: %d (%s:%d)", #call, (int)r_, __FILE__, __LINE__);                   \
+        }                                                                                         \
+    } while (0)
+
+// ----------------------------------------------------------------------------------------------
+// Constants and small types
+// ----------------------------------------------------------------------------------------------
+
+constexpr uint32_t kFrames = 2;     // frames in flight (CPU recording ahead of the GPU)
+constexpr uint32_t kSwapImages = 3; // VideoOut buffers, as in DolphinPS4
+constexpr uint32_t kOutW = 1920, kOutH = 1080;
+constexpr VkDeviceSize kVideoOutAlign = 2 << 20; // VideoOut buffers must be 2 MiB aligned
+constexpr VkFormat kColorFormat = VK_FORMAT_R8G8B8A8_UNORM;
+constexpr VkFormat kDepthFormat = VK_FORMAT_D32_SFLOAT;
+constexpr uint32_t kSetsPerPool = 4096;
+
+// Mirrors the push constant block injected into every fragment shader (RewriteForVulkan).
+struct PushConstants {
+    int32_t frame_count;
+    float noise_scale;
+    float prim_depth;
+    float alpha_compare_threshold;
+    int32_t texture_width[2];
+    int32_t texture_height[2];
+    int32_t texture_filtering[2];
+};
+static_assert(sizeof(PushConstants) == 40, "push constant layout");
+
+
+struct ShaderProgramVk {
+    uint32_t index;
+    uint8_t numInputs;
+    bool usedTextures[SHADER_MAX_TEXTURES];
+    uint8_t numFloats;
+    uint8_t numAttribs;
+    uint8_t attribSizes[16];
+    bool blend;
+    VkShaderModule vs = VK_NULL_HANDLE;
+    VkShaderModule fs = VK_NULL_HANDLE;
+};
+
+struct VkTex {
+    VkImage image = VK_NULL_HANDLE;
+    VmaAllocation alloc = VK_NULL_HANDLE;
+    VkImageView view = VK_NULL_HANDLE;
+    VkImageLayout layout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    uint32_t width = 0, height = 0;
+    bool linear = false; // linear_filter from SetSamplerParameters
+    uint32_t cms = 0, cmt = 0;
+    int32_t filtering = FILTER_THREE_POINT; // what the shader's texture_filtering[] reads (OpenGL semantics)
+    uint64_t lastUse = 0;                    // frame serial of the last draw that sampled it
+    VkDescriptorSet imgui = VK_NULL_HANDLE;  // ImGui texture id, created on demand
+    bool isFramebuffer = false;
+};
+
+struct Framebuffer {
+    uint32_t width = 0, height = 0;
+    bool hasDepth = false;
+    bool isSwap = false; // framebuffer 0: the VideoOut buffers
+    uint32_t colorTex = 0; // index into textures (offscreen framebuffers)
+    VkImage depth = VK_NULL_HANDLE;
+    VmaAllocation depthAlloc = VK_NULL_HANDLE;
+    VkImageView depthView = VK_NULL_HANDLE;
+    VkFramebuffer fb[kSwapImages] = {};
+};
+
+struct SwapImage {
+    VkImage image = VK_NULL_HANDLE;
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    VkImageView view = VK_NULL_HANDLE;
+    void* address = nullptr;
+};
+
+struct BufferChunk {
+    VkBuffer buffer = VK_NULL_HANDLE;
+    VmaAllocation alloc = VK_NULL_HANDLE;
+    uint8_t* map = nullptr;
+    VkDeviceSize size = 0, used = 0;
+};
+
+// Per-frame linear allocator over host-visible buffers; reset when the frame slot is reused.
+struct Ring {
+    VkBufferUsageFlags usage = 0;
+    VkDeviceSize chunkSize = 0;
+    std::vector<BufferChunk> chunks;
+    size_t current = 0;
+};
+
+struct Frame {
+    VkCommandPool pool = VK_NULL_HANDLE;
+    VkCommandBuffer cmd = VK_NULL_HANDLE;
+    VkCommandBuffer upload = VK_NULL_HANDLE;
+    VkFence fence = VK_NULL_HANDLE;
+    bool pending = false;
+    Ring vertices, staging;
+    std::vector<VkDescriptorPool> pools;
+    size_t poolIndex = 0;
+    std::vector<std::function<void()>> garbage;
+};
+
+struct SetKey {
+    std::array<uint64_t, SHADER_MAX_TEXTURES * 2> v;
+    bool operator==(const SetKey& o) const {
+        return v == o.v;
+    }
+};
+struct SetKeyHash {
+    size_t operator()(const SetKey& k) const {
+        uint64_t h = 1469598103934665603ull;
+        for (uint64_t x : k.v) {
+            h ^= x;
+            h *= 1099511628211ull;
+        }
+        return (size_t)h;
+    }
+};
+
+VkSamplerAddressMode AddressMode(uint32_t cm, bool mirrorClampSupported) {
+    if (cm & G_TX_CLAMP) {
+        // N64 MIRROR|CLAMP mirrors once and then clamps (see the D3D11 backend).
+        if (cm & G_TX_MIRROR) {
+            return mirrorClampSupported ? VK_SAMPLER_ADDRESS_MODE_MIRROR_CLAMP_TO_EDGE
+                                        : VK_SAMPLER_ADDRESS_MODE_MIRRORED_REPEAT;
+        }
+        return VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+    }
+    return (cm & G_TX_MIRROR) ? VK_SAMPLER_ADDRESS_MODE_MIRRORED_REPEAT : VK_SAMPLER_ADDRESS_MODE_REPEAT;
+}
+
+VkFormat AttribFormat(uint8_t size) {
+    switch (size) {
+        case 1:
+            return VK_FORMAT_R32_SFLOAT;
+        case 2:
+            return VK_FORMAT_R32G32_SFLOAT;
+        case 3:
+            return VK_FORMAT_R32G32B32_SFLOAT;
+        default:
+            return VK_FORMAT_R32G32B32A32_SFLOAT;
+    }
+}
+
+// Shader template resources (the text itself is built by gfx_vulkan_shader.cpp)
+
+std::shared_ptr<Ship::Shader> LoadShaderResource(const std::string& path) {
+    auto init = std::make_shared<Ship::ResourceInitData>();
+    init->Type = (uint32_t)Ship::ResourceType::Shader;
+    init->ByteOrder = Ship::Endianness::Native;
+    init->Format = RESOURCE_FORMAT_BINARY;
+    return std::static_pointer_cast<Ship::Shader>(
+        Ship::Context::GetInstance()->GetResourceManager()->LoadResource(path, true, init));
+}
+
+std::optional<std::string> IncludeLoader(const std::string& path) {
+    auto res = LoadShaderResource(path);
+    if (res == nullptr) {
+        return std::nullopt;
+    }
+    return *static_cast<std::string*>(res->GetRawPointer());
+}
+
+std::string ShaderTemplatePath(const CCFeatures& cc) {
+    const char* shaderName = gfx_get_shader(cc.shader_id);
+    return shaderName != nullptr ? std::string(shaderName) + ".glsl" : "shaders/opengl/default.shader.glsl";
+}
+
+std::vector<uint32_t> CompileSpv(const std::string& source, EShLanguage stage, std::string* error) {
+    static bool initialized = [] {
+        glslang::InitializeProcess();
+        return true;
+    }();
+    (void)initialized;
+
+    const char* strings[] = { source.c_str() };
+    glslang::TShader shader(stage);
+    shader.setStrings(strings, 1);
+    shader.setEnvInput(glslang::EShSourceGlsl, stage, glslang::EShClientVulkan, 100);
+    shader.setEnvClient(glslang::EShClientVulkan, glslang::EShTargetVulkan_1_1);
+    shader.setEnvTarget(glslang::EShTargetSpv, glslang::EShTargetSpv_1_3);
+    const EShMessages messages = (EShMessages)(EShMsgSpvRules | EShMsgVulkanRules);
+    if (!shader.parse(GetDefaultResources(), 450, false, messages)) {
+        *error = std::string("parse: ") + shader.getInfoLog();
+        return {};
+    }
+    glslang::TProgram program;
+    program.addShader(&shader);
+    if (!program.link(messages)) {
+        *error = std::string("link: ") + program.getInfoLog();
+        return {};
+    }
+    std::vector<uint32_t> spv;
+    glslang::SpvOptions options;
+    options.generateDebugInfo = false;
+    options.disableOptimizer = true;
+    glslang::GlslangToSpv(*program.getIntermediate(stage), spv, &options);
+    if (spv.empty()) {
+        *error = "empty SPIR-V";
+    }
+    return spv;
+}
