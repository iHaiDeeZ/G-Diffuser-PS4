+
+void GfxRenderingAPIVulkan::ClearShaderCache() {
+    VulkanState& s = *mState;
+    VkDevice dev = s.device;
+    for (auto& [key, pipeline] : s.pipelines) {
+        VkPipeline p = pipeline;
+        s.Retire([=] { vkDestroyPipeline(dev, p, nullptr); });
+    }
+    s.pipelines.clear();
+    for (auto& [key, prg] : s.programs) {
+        VkShaderModule vs = prg.vs, fs = prg.fs;
+        s.Retire([=] {
+            vkDestroyShaderModule(dev, vs, nullptr);
+            vkDestroyShaderModule(dev, fs, nullptr);
+        });
+    }
+    s.programs.clear();
+    s.program = nullptr;
+    s.boundPipeline = VK_NULL_HANDLE;
+}
+
+ShaderProgram* GfxRenderingAPIVulkan::CreateAndLoadNewShader(uint64_t shaderId0, uint64_t shaderId1) {
+    VulkanState& s = *mState;
+    CCFeatures cc;
+    gfx_cc_get_features(shaderId0, shaderId1, &cc);
+
+    const uint64_t t0 = sceKernelGetProcessTime();
+    auto templ = LoadShaderResource(ShaderTemplatePath(cc));
+    if (templ == nullptr) {
+        SPDLOG_ERROR("Failed to load the Fast3D shader template, missing gdiffuser.o2r?");
+        abort();
+    }
+    const GdxVulkanShaderText text =
+        GdxBuildVulkanShaders(cc, *static_cast<std::string*>(templ->GetRawPointer()),
+                              s.filterMode == FILTER_THREE_POINT, mSrgbMode, IncludeLoader);
+    const std::string& vsGlsl = text.vs;
+    const std::string& fsGlsl = text.fs;
+    const size_t numFloats = text.numFloats;
+    std::string error;
+    std::vector<uint32_t> vsSpv = CompileSpv(vsGlsl, EShLangVertex, &error);
+    if (vsSpv.empty()) {
+        SPDLOG_ERROR("Vulkan vertex shader {:016X}:{:016X} failed: {}\n{}", shaderId0, shaderId1, error, vsGlsl);
+        Trace("vertex shader compile failed: %s", error.c_str());
+        abort();
+    }
+    std::vector<uint32_t> fsSpv = CompileSpv(fsGlsl, EShLangFragment, &error);
+    if (fsSpv.empty()) {
+        SPDLOG_ERROR("Vulkan fragment shader {:016X}:{:016X} failed: {}\n{}", shaderId0, shaderId1, error, fsGlsl);
+        Trace("fragment shader compile failed: %s", error.c_str());
+        abort();
+    }
+
+    ShaderProgramVk& prg = s.programs[std::make_pair(shaderId0, shaderId1)];
+    prg.index = s.nextProgramIndex++;
+    VkShaderModuleCreateInfo minfo = { VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO };
+    minfo.codeSize = vsSpv.size() * 4;
+    minfo.pCode = vsSpv.data();
+    VK_CHECK(vkCreateShaderModule(s.device, &minfo, nullptr, &prg.vs));
+    minfo.codeSize = fsSpv.size() * 4;
+    minfo.pCode = fsSpv.data();
+    VK_CHECK(vkCreateShaderModule(s.device, &minfo, nullptr, &prg.fs));
+
+    // Same attribute order as the vertex template (and the OpenGL backend).
+    uint8_t cnt = 0;
+    prg.attribSizes[cnt++] = 4;
+    for (int i = 0; i < 2; i++) {
+        if (cc.usedTextures[i]) {
+            prg.attribSizes[cnt++] = 2;
+            for (int j = 0; j < 2; j++) {
+                if (cc.clamp[i][j]) {
+                    prg.attribSizes[cnt++] = 1;
+                }
+            }
+        }
+    }
+    if (cc.opt_fog) {
+        prg.attribSizes[cnt++] = 4;
+    }
+    if (cc.opt_grayscale) {
+        prg.attribSizes[cnt++] = 4;
+    }
+    for (int i = 0; i < cc.numInputs; i++) {
+        prg.attribSizes[cnt++] = cc.opt_alpha ? 4 : 3;
+    }
+    prg.numAttribs = cnt;
+    prg.numFloats = (uint8_t)numFloats;
+    prg.numInputs = cc.numInputs;
+    prg.usedTextures[0] = cc.usedTextures[0];
+    prg.usedTextures[1] = cc.usedTextures[1];
+    prg.usedTextures[2] = cc.used_masks[0];
+    prg.usedTextures[3] = cc.used_masks[1];
+    prg.usedTextures[4] = cc.used_blend[0];
+    prg.usedTextures[5] = cc.used_blend[1];
+    prg.blend = cc.opt_alpha;
+
+    static int sCount = 0;
+    if (++sCount <= 20 || sCount % 50 == 0) {
+        Trace("shader #%d %016llX:%016llX in %llu us", sCount, (unsigned long long)shaderId0,
+              (unsigned long long)shaderId1, (unsigned long long)(sceKernelGetProcessTime() - t0));
+    }
+    s.program = &prg;
+    return (ShaderProgram*)&prg;
+}
