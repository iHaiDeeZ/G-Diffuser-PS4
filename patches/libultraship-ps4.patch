diff --git a/cmake/dependencies/ps4.cmake b/cmake/dependencies/ps4.cmake
new file mode 100644
index 00000000..af361e43
--- /dev/null
+++ b/cmake/dependencies/ps4.cmake
@@ -0,0 +1,105 @@
+# PS4 homebrew (PacBrew OpenOrbis toolchain + DolphinPS4's clang 21 / libc++ 21, see
+# G-Diffuser-PS4/toolchain). C libraries come from PacBrew; C++ libraries are built from source so
+# they use the same libc++ as everything else.
+include(FetchContent)
+
+set(OPENORBIS_USR "${OPENORBIS}/usr")
+
+#=================== SDL2 (PacBrew: joystick + audio drivers; no SDL video) ===================
+add_library(SDL2::SDL2 STATIC IMPORTED GLOBAL)
+set_target_properties(SDL2::SDL2 PROPERTIES
+    IMPORTED_LOCATION "${OPENORBIS_USR}/lib/libSDL2.a"
+    INTERFACE_INCLUDE_DIRECTORIES "${OPENORBIS_USR}/include/SDL2"
+    INTERFACE_COMPILE_DEFINITIONS "_REENTRANT")
+# From PacBrew's sdl2.pc. SDL's PS4 video driver needs Piglet; it is linked but never started.
+target_link_libraries(SDL2::SDL2 INTERFACE
+    "${OPENORBIS_USR}/lib/libsamplerate.a" -lSceSystemService -lSceSysUtil -lSceSysmodule
+    -lSceUserService -lSceAudioOut -lScePad -lScePigletv2VSH)
+set(SDL2_FOUND TRUE)
+set(SDL2_INCLUDE_DIRS "${OPENORBIS_USR}/include/SDL2")
+set(SDL2_LIBRARIES SDL2::SDL2)
+target_link_libraries(ImGui PUBLIC SDL2::SDL2)
+
+#=================== zlib / bzip2 (PacBrew) ===================
+add_library(ZLIB::ZLIB STATIC IMPORTED GLOBAL)
+set_target_properties(ZLIB::ZLIB PROPERTIES
+    IMPORTED_LOCATION "${OPENORBIS_USR}/lib/libz.a"
+    INTERFACE_INCLUDE_DIRECTORIES "${OPENORBIS_USR}/include")
+set(ZLIB_FOUND TRUE)
+set(ZLIB_LIBRARY "${OPENORBIS_USR}/lib/libz.a" CACHE FILEPATH "" FORCE)
+set(ZLIB_INCLUDE_DIR "${OPENORBIS_USR}/include" CACHE PATH "" FORCE)
+set(BZIP2_LIBRARY_RELEASE "${OPENORBIS_USR}/lib/libbz2.a" CACHE FILEPATH "" FORCE)
+set(BZIP2_LIBRARIES "${OPENORBIS_USR}/lib/libbz2.a" CACHE FILEPATH "" FORCE)
+set(BZIP2_INCLUDE_DIR "${OPENORBIS_USR}/include" CACHE PATH "" FORCE)
+
+#=================== nlohmann-json ===================
+FetchContent_Declare(
+    nlohmann_json
+    GIT_REPOSITORY https://github.com/nlohmann/json.git
+    GIT_TAG v3.12.0
+    OVERRIDE_FIND_PACKAGE
+)
+FetchContent_MakeAvailable(nlohmann_json)
+
+#=================== tinyxml2 ===================
+set(tinyxml2_BUILD_TESTING OFF)
+FetchContent_Declare(
+    tinyxml2
+    GIT_REPOSITORY https://github.com/leethomason/tinyxml2.git
+    GIT_TAG 11.0.0
+    OVERRIDE_FIND_PACKAGE
+)
+FetchContent_MakeAvailable(tinyxml2)
+
+#=================== spdlog ===================
+FetchContent_Declare(
+    spdlog
+    GIT_REPOSITORY https://github.com/gabime/spdlog.git
+    GIT_TAG v1.16.0
+    OVERRIDE_FIND_PACKAGE
+)
+FetchContent_MakeAvailable(spdlog)
+
+#=================== libzip ===================
+set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
+set(BUILD_TOOLS OFF)
+set(BUILD_REGRESS OFF)
+set(BUILD_EXAMPLES OFF)
+set(BUILD_DOC OFF)
+set(BUILD_OSSFUZZ OFF)
+set(BUILD_SHARED_LIBS OFF)
+set(ENABLE_COMMONCRYPTO OFF)
+set(ENABLE_GNUTLS OFF)
+set(ENABLE_MBEDTLS OFF)
+set(ENABLE_OPENSSL OFF)
+set(ENABLE_WINDOWS_CRYPTO OFF)
+set(ENABLE_LZMA OFF)
+set(ENABLE_ZSTD OFF)
+set(ENABLE_BZIP2 ON)
+FetchContent_Declare(
+    libzip
+    GIT_REPOSITORY https://github.com/nih-at/libzip.git
+    GIT_TAG v1.11.4
+    OVERRIDE_FIND_PACKAGE
+)
+FetchContent_MakeAvailable(libzip)
+list(APPEND ADDITIONAL_LIB_INCLUDES ${libzip_SOURCE_DIR}/lib ${libzip_BINARY_DIR})
+
+#=================== Vulkan (Mesa RADV on GNM, from DolphinPS4) ===================
+# Headers only here: the driver itself is linked into the executable (ps4_link_mesa).
+set(PS4_MESA_SRC "$ENV{PS4_MESA_SRC}" CACHE PATH "Mesa source tree (Vulkan headers)")
+if (NOT EXISTS "${PS4_MESA_SRC}/include/vulkan/vulkan_core.h")
+    message(FATAL_ERROR "PS4_MESA_SRC (${PS4_MESA_SRC}) has no include/vulkan; see scripts/ps4-env.sh")
+endif ()
+list(APPEND ADDITIONAL_LIB_INCLUDES "${PS4_MESA_SRC}/include")
+target_include_directories(ImGui PUBLIC "${PS4_MESA_SRC}/include")
+
+#=================== Vulkan Memory Allocator (header only, as in Dolphin) ===================
+FetchContent_Declare(
+    VulkanMemoryAllocator
+    GIT_REPOSITORY https://github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator.git
+    GIT_TAG v3.1.0
+    SOURCE_SUBDIR do-not-add-subdirectory
+)
+FetchContent_MakeAvailable(VulkanMemoryAllocator)
+list(APPEND ADDITIONAL_LIB_INCLUDES "${vulkanmemoryallocator_SOURCE_DIR}/include")
