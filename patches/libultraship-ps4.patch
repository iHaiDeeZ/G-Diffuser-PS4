+
+void GfxRenderingAPIVulkan::DrawTriangles(float buf_vbo[], size_t buf_vbo_len, size_t buf_vbo_num_tris) {
+    VulkanState& s = *mState;
+    ShaderProgramVk* prg = s.program;
+    if (prg == nullptr || buf_vbo_num_tris == 0) {
+        return;
+    }
+    s.EnsureRenderPass();
+    if (!s.inRenderPass) {
+        return;
+    }
+    Framebuffer& fb = s.framebuffers[s.currentFb];
+    VkCommandBuffer cb = s.F().cmd;
+
+    VkPipeline pipeline = s.Pipeline(prg, mCurrentDepthTest, mCurrentDepthMask, mCurrentZmodeDecal, fb.hasDepth);
+    if (pipeline != s.boundPipeline) {
+        vkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+        s.boundPipeline = pipeline;
+        s.boundSet = VK_NULL_HANDLE;
+    }
+    if (s.viewportDirty) {
+        vkCmdSetViewport(cb, 0, 1, &s.viewport);
+        s.viewportDirty = false;
+    }
+    if (s.scissorDirty) {
+        vkCmdSetScissor(cb, 0, 1, &s.scissor);
+        s.scissorDirty = false;
+    }
+
+    // Decal depth bias, as the D3D11 backend computes it (slope-scaled only).
+    float bias = 0.0f;
+    if (mCurrentZmodeDecal) {
+        bias = -2.0f;
+        switch (Ship::Context::GetInstance()->GetConsoleVariables()->GetInteger(CVAR_Z_FIGHTING_MODE, 0)) {
+            case 1:
+                bias = -1.0f * (float)s.renderTargetHeight / 120;
+                break;
+            case 2:
+                bias = -1.0f * (float)s.renderTargetHeight / 100;
+                break;
+            default:
+                break;
+        }
+    }
+    if (s.depthBiasDirty || bias != s.depthBias) {
+        vkCmdSetDepthBias(cb, 0.0f, 0.0f, bias);
+        s.depthBias = bias;
+        s.depthBiasDirty = false;
+    }
+
+    // Textures: binding = texture unit. Unused units get texture 0.
+    SetKey key;
+    VkDescriptorImageInfo images[SHADER_MAX_TEXTURES];
+    PushConstants pc = {};
+    for (int i = 0; i < SHADER_MAX_TEXTURES; i++) {
+        VkTex* tp = prg->usedTextures[i] ? &s.Tex(s.textureIds[i]) : &s.textures[0];
+        if (i == 1 && prg->usedTextures[1] && tp == &s.textures[0] && prg->usedTextures[0]) {
+            // TEXEL1 with nothing loaded on its tile: in one-cycle mode the N64 reads TEXEL1 as
+            // (the next pixel's) TEXEL0, so unit 0's texture is the faithful stand-in, not white.
+            tp = &s.Tex(s.textureIds[0]);
+        }
+        VkTex& t = *tp;
+        t.lastUse = s.serial;
+        const bool linearHw = t.linear && s.filterMode == FILTER_LINEAR;
+        images[i].sampler = s.Sampler(linearHw, t.cms, t.cmt);
+        images[i].imageView = t.view;
+        images[i].imageLayout = t.layout;
+        key.v[i * 2] = (uint64_t)(uintptr_t)images[i].imageView;
+        key.v[i * 2 + 1] = (uint64_t)(uintptr_t)images[i].sampler;
+        if (i < 2) {
+            pc.texture_width[i] = (int32_t)t.width;
+            pc.texture_height[i] = (int32_t)t.height;
+            pc.texture_filtering[i] = t.filtering;
+        }
+    }
+    VkDescriptorSet set;
+    auto it = s.setCache.find(key);
+    if (it != s.setCache.end()) {
+        set = it->second;
+    } else {
+        set = s.AllocateSet();
+        VkWriteDescriptorSet writes[SHADER_MAX_TEXTURES];
+        for (uint32_t i = 0; i < SHADER_MAX_TEXTURES; i++) {
+            writes[i] = { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET };
+            writes[i].dstSet = set;
+            writes[i].dstBinding = i;
+            writes[i].descriptorCount = 1;
+            writes[i].descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+            writes[i].pImageInfo = &images[i];
+        }
+        vkUpdateDescriptorSets(s.device, SHADER_MAX_TEXTURES, writes, 0, nullptr);
+        s.setCache.emplace(key, set);
+    }
+    if (set != s.boundSet) {
+        vkCmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_GRAPHICS, s.pipelineLayout, 0, 1, &set, 0, nullptr);
+        s.boundSet = set;
+    }
+
+    pc.frame_count = (int32_t)s.frameCount;
+    pc.noise_scale = s.noiseScale;
+    pc.prim_depth = mCurrentPrimDepth;
+    pc.alpha_compare_threshold = mCurrentAlphaCompareThreshold;
+    vkCmdPushConstants(cb, s.pipelineLayout, VK_SHADER_STAGE_FRAGMENT_BIT, 0, sizeof(pc), &pc);
+
+    VkBuffer buffer;
+    VkDeviceSize offset;
+    uint8_t* dst = s.RingAlloc(s.F().vertices, buf_vbo_len * sizeof(float), 16, &buffer, &offset);
+    memcpy(dst, buf_vbo, buf_vbo_len * sizeof(float));
+    vkCmdBindVertexBuffers(cb, 0, 1, &buffer, &offset);
+    vkCmdDraw(cb, (uint32_t)(buf_vbo_num_tris * 3), 1, 0, 0);
+}
