+
+int SamplerBinding(const std::string& name) {
+    static const char* const names[SHADER_MAX_TEXTURES] = { "uTex0",     "uTex1",      "uTexMask0",
+                                                            "uTexMask1", "uTexBlend0", "uTexBlend1" };
+    for (int i = 0; i < SHADER_MAX_TEXTURES; i++) {
+        if (name == names[i]) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+// GLSL 4.50 as the template emits it -> Vulkan GLSL. `varyings` maps varying names to locations:
+// filled by the vertex shader, read by the fragment shader.
+std::string RewriteForVulkan(const std::string& src, bool vertex, std::map<std::string, int>& varyings) {
+    static const std::regex reIo(R"(^\s*(in|out)\s+(\w+)\s+(\w+)\s*;\s*$)");
+    static const std::regex reSampler(R"(^\s*uniform\s+sampler2D\s+(\w+)\s*;\s*$)");
+    static const std::regex reUniform(R"(^\s*uniform\s+\w+\s+\w+\s*(\[\s*\d+\s*\])?\s*;\s*$)");
+    std::istringstream in(src);
+    std::ostringstream out;
+    std::string line;
+    int attribLocation = 0;
+    int varyingLocation = 0;
+    bool versionDone = false;
+    while (std::getline(in, line)) {
+        std::smatch m;
+        if (!versionDone && line.find("#version") != std::string::npos) {
+            out << "#version 450\n";
+            if (!vertex) {
+                out << kPushBlock;
+            }
+            versionDone = true;
+            continue;
+        }
+        if (std::regex_match(line, m, reIo)) {
+            const std::string dir = m[1], type = m[2], name = m[3];
+            int location = 0;
+            if (vertex && dir == "in") {
+                location = attribLocation++;
+            } else if (vertex) {
+                location = varyingLocation++;
+                varyings[name] = location;
+            } else if (dir == "in") {
+                auto it = varyings.find(name);
+                location = it != varyings.end() ? it->second : 15;
+                if (it == varyings.end()) {
+                    fprintf(stderr, "gfx_vulkan_shader: fragment input %s has no matching vertex output\n",
+                                            name.c_str());
+                }
+            } else {
+                location = 0; // the color output
+            }
+            out << "layout(location = " << location << ") " << dir << " " << type << " " << name << ";\n";
+            continue;
+        }
+        if (std::regex_match(line, m, reSampler)) {
+            const int binding = SamplerBinding(m[1]);
+            out << "layout(set = 0, binding = " << (binding < 0 ? 0 : binding) << ") uniform sampler2D " << m[1]
+                << ";\n";
+            continue;
+        }
+        if (std::regex_match(line, m, reUniform)) {
+            continue; // provided by the push constant block
+        }
+        out << line << "\n";
+    }
+    return out.str();
+}
+
+} // namespace
+
+GdxVulkanShaderText GdxBuildVulkanShaders(const CCFeatures& cc, const std::string& templateText,
+                                          bool threePointFiltering, bool srgb, GdxShaderIncludeFunc include) {
+    GdxVulkanShaderText out;
+    std::map<std::string, int> varyings;
+    out.vs = RewriteForVulkan(BuildVs(cc, templateText, include), true, varyings);
+    out.numFloats = sNumFloats;
+    out.fs = RewriteForVulkan(BuildFs(cc, threePointFiltering, srgb, templateText, include), false, varyings);
+    return out;
+}
