+// The game framebuffer, upscaled with FSR when it is smaller than the output (or -1: show it as is).
+static int GdxFsrUpscale(GfxRenderingAPIVulkan* api, VulkanState& s, int srcFb) {
+    if (CVarGetInteger("gPs4.FsrMode", 0) == 0 || srcFb <= 0 || srcFb >= (int)s.framebuffers.size()) {
+        return -1;
+    }
+    const Framebuffer& in = s.framebuffers[srcFb];
+    if (in.width == 0 || in.height == 0 || in.height >= kOutH) {
+        return -1; // native or larger: nothing to upscale
+    }
+    if (!FsrPipelines(s)) {
+        return -1;
+    }
+    // output: the screen height, keeping the frame's aspect (ImGui then draws it 1:1)
+    uint32_t outH = kOutH;
+    uint32_t outW = (uint32_t)((uint64_t)in.width * kOutH / in.height);
+    if (outW > kOutW) {
+        outW = kOutW;
+        outH = (uint32_t)((uint64_t)in.height * kOutW / in.width);
+    }
+    for (int i = 0; i < 2; i++) {
+        if (s.fsrFb[i] < 0) {
+            s.fsrFb[i] = api->CreateFramebuffer();
+        }
+        api->UpdateFramebufferParameters(s.fsrFb[i], outW, outH, 1, false, true, false, false);
+    }
+    const int previousFb = s.currentFb;
+    // sharpness 0..10 (10 = sharpest) -> RCAS stops 2.0..0.0
+    const float stops = std::clamp(10 - CVarGetInteger("gPs4.FsrSharpness", 8), 0, 10) * 0.2f;
+    FsrPass(s, 0, srcFb, s.fsrFb[0], outW, outH, stops);
+    FsrPass(s, 1, s.fsrFb[0], s.fsrFb[1], outW, outH, stops);
+    s.MemoryBarrier(s.F().cmd, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+                    VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT);
+    s.currentFb = previousFb;
+    s.boundPipeline = VK_NULL_HANDLE;
+    s.boundSet = VK_NULL_HANDLE;
+    s.viewportDirty = s.scissorDirty = s.depthBiasDirty = true;
+    static bool sLogged = false;
+    if (!sLogged) {
+        sLogged = true;
+        Trace("FSR 1.0: %ux%u -> %ux%u", in.width, in.height, outW, outH);
+    }
+    return s.fsrFb[1];
+}
