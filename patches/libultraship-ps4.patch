diff --git a/include/ship/audio/Ps4AudioPlayer.h b/include/ship/audio/Ps4AudioPlayer.h
new file mode 100644
index 00000000..5d2ef3ff
--- /dev/null
+++ b/include/ship/audio/Ps4AudioPlayer.h
@@ -0,0 +1,50 @@
+#pragma once
+#ifdef __ORBIS__
+#include "AudioPlayer.h"
+
+#include <atomic>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace Ship {
+/**
+ * @brief AudioPlayer on the PS4's sceAudioOut.
+ *
+ * PacBrew's SDL2 has no working audio output on the console, so the game's stream goes straight
+ * to a main-type audio port. The game produces 32 kHz (AudioSettings::SampleRate) and sceAudioOut
+ * runs at 48 kHz only: DoPlay queues the game's frames in a ring, and an output thread resamples
+ * them (linear) into 256-sample grains, each sceAudioOutOutput call blocking for one grain.
+ */
+class Ps4AudioPlayer final : public AudioPlayer {
+  public:
+    Ps4AudioPlayer(AudioSettings settings) : AudioPlayer(settings) {
+    }
+    ~Ps4AudioPlayer();
+
+    /** @brief Frames (at the game's rate) queued and not yet played. */
+    int Buffered() override;
+
+    const char* GetBackendName() const override {
+        return "sceAudioOut";
+    }
+
+  protected:
+    bool DoInit() override;
+    void DoClose() override;
+    void DoPlay(const uint8_t* buf, size_t len) override;
+
+  private:
+    void OutputLoop();
+
+    int32_t mPort = -1;
+    int32_t mNumChannels = 2;
+    std::thread mThread;
+    std::atomic<bool> mRunning{ false };
+    std::mutex mMutex;
+    std::vector<int16_t> mRing; // stereo frames at the game's rate
+    size_t mRead = 0;           // frame index
+    size_t mCount = 0;          // frames queued
+};
+} // namespace Ship
+#endif
